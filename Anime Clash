/* ---------------- INTELIGENCIA ARTIFICIAL (CPU) ---------------- */
const AI = { t: 0, plan: 'approach' };
function cpuInput(me, opp) {
  const i = { ...NOINPUT };
  if (Game.phase !== 'fight' || me.state === 'defeat') return i;
  const dx = opp.x - me.x, d = Math.abs(dx), s = dx >= 0 ? 1 : -1, toward = s > 0 ? 'right' : 'left';
  if (--AI.t <= 0) {
    AI.t = rnd(10, 30);
    AI.plan = d > 200 ? 'approach' : (rnd() < 0.6 ? 'press' : 'guard');
  }
  if (me.def.canTransform && !me.form && me.energy >= 100) i.g = true;
  if (me.form && !me.ultUsed && d < 220 && rnd() < 0.03) i.g = true;
  if (AI.plan === 'approach') { i[toward] = true; if (d < 180 && rnd() < 0.05) i.r = true; }
  else if (AI.plan === 'press') { if (d > 80) i[toward] = true; else if (rnd() < 0.25) i.atk = true; }
  else if (AI.plan === 'guard') { i.block = true; }
  if (me.energy >= F_COST && rnd() < 0.02) i.f = true;
  return i;
}

/* ---------------- RED P2P (PEERJS) ---------------- */
const Net = {
  peer: null, conn: null, role: null, code: null, ping: 0,
  available() { return typeof window.Peer === 'function'; },
  genCode() { const a = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let s = ''; for (let i = 0; i < 5; i++) s += a[Math.floor(Math.random() * a.length)]; return s; },
  host() {
    this.close(); this.role = 'host'; this.code = this.genCode();
    $('lobby-code').textContent = this.code;
    this.peer = new Peer(PEER_PREFIX + this.code, { debug: 0 });
    this.peer.on('open', () => { $('lobby-msg').textContent = 'Sala lista. Comparte el código con tu rival.'; });
    this.peer.on('connection', c => { if (this.conn) { c.close(); return; } this.bind(c); });
    this.peer.on('error', e => { if (e.type === 'unavailable-id') this.host(); });
  },
  join(code) {
    this.close(); this.role = 'guest'; this.code = code;
    this.peer = new Peer({ debug: 0 });
    this.peer.on('open', () => { this.bind(this.peer.connect(PEER_PREFIX + code, { reliable: true })); });
    this.peer.on('error', () => { setMenuMsg('No se pudo encontrar la sala ' + code, true); this.close(); });
  },
  bind(c) {
    this.conn = c;
    c.on('open', () => { SFX.init(); Game.mode = 'online'; Sel.reset(); show('scr-select'); toast('¡Rival conectado!'); });
    c.on('data', onMsg);
    c.on('close', () => { if (this.conn === c) onDisconnected(); });
  },
  send(o) { if (this.conn && this.conn.open) { try { this.conn.send(o); } catch (e) {} } },
  close() { if (this.conn) { try { this.conn.close(); } catch (e) {} this.conn = null; } if (this.peer) { try { this.peer.destroy(); } catch (e) {} this.peer = null; } }
};

function onDisconnected() { Net.close(); Game.running = false; show('scr-menu'); setMenuMsg('El rival se ha desconectado.', true); }
function onMsg(m) {
  if (!m || typeof m !== 'object') return;
  switch (m.t) {
    case 'pick': Sel.opp = ROSTER[m.id] ? m.id : null; Sel.render(); break;
    case 'ready': Sel.oppReady = !!m.v; Sel.render(); Sel.tryStart(); break;
    case 'start': if (ROSTER[m.a] && ROSTER[m.b]) startMatch(m.a, m.b); break;
    case 's': if (Game.running && Game.opp) Game.opp.applyState(m); break;
    case 'hit': if (Game.running && Game.me) Game.me.takeHit(m); break;
    case 'parried': if (Game.running && Game.me) Game.me.getParried(m.s); break;
    case 'rematch': Game.remOpp = true; checkRematch(); break;
    case 'toselect': Sel.reset(); show('scr-select'); Game.running = false; break;
  }
}

/* ---------------- GESTIÓN DE PARTIDA ---------------- */
const Game = {
  mode: null, running: false, phase: 'idle', fighters: [], me: null, opp: null, projs: [],
  timer: ROUND_TIME, frameCount: 0, introT: 0, endT: 0, winner: -1,
  hitstop: 0, shake: 0, flash: 0, remMe: false, remOpp: false, picks: null,
  other(f) { return this.fighters[0] === f ? this.fighters[1] : this.fighters[0]; },
  onKO(f) {
    if (this.phase !== 'fight') return;
    SFX.play('ko');
    const w = this.other(f).side;
    this.finish(w);
  },
  finish(w) {
    if (this.phase === 'end') return;
    this.phase = 'end'; this.winner = w; this.endT = 0; this.flash = 12;
  }
};

function startMatch(a, b) {
  SFX.init();
  const mySide = Game.mode === 'online' && Net.role === 'guest' ? 1 : 0;
  Game.fighters = [new Fighter(a, 0, mySide === 0 ? 'local' : 'remote'), new Fighter(b, 1, mySide === 1 ? 'local' : (Game.mode === 'cpu' ? 'cpu' : 'remote'))];
  Game.me = Game.fighters[mySide]; Game.opp = Game.fighters[1 - mySide];
  Game.projs = []; FX.l = []; Game.timer = ROUND_TIME; Game.phase = 'intro'; Game.introT = 0;
  Game.hitstop = 0; Game.shake = 0; Game.flash = 0; Game.cine = null; Game.remMe = false; Game.remOpp = false; Game.picks = [a, b];
  Game.running = true; hideAll();
}

function checkRematch() {
  if (Game.mode !== 'online') return;
  if (Game.remMe && Game.remOpp && Net.role === 'host') { const [a, b] = Game.picks; Net.send({ t: 'start', a, b }); startMatch(a, b); }
  else if (Game.remOpp && !Game.remMe) $('res-msg').textContent = 'El rival quiere la revancha.';
}

function step() {
  T++;
  const G = Game;
  if (!G.running) { FX.update(); return; }
  if (G.phase === 'intro') {
    if (++G.introT >= 100) G.phase = 'fight';
  }
  const local = readLocal();
  if (G.hitstop > 0) { G.hitstop--; sendState(); FX.update(); return; }

  for (const f of G.fighters) {
    const opp = G.other(f);
    if (f.ctl === 'remote') f.updateRemote();
    else {
      const inp = G.phase !== 'fight' ? NOINPUT : f.ctl === 'cpu' ? cpuInput(f, opp) : local;
      f.update(inp, opp);
    }
    f.tickFx();
    f.hpLag += (f.hp - f.hpLag) * 0.06;
  }

  const a = G.fighters[0], b = G.fighters[1];
  if (a.state !== 'defeat' && b.state !== 'defeat') {
    const A = a.hurt(), B = b.hurt();
    if (overlap(A, B)) {
      const ov = (A.w + B.w) / 2 - Math.abs(a.x - b.x);
      if (ov > 0) {
        const s = a.x < b.x ? -1 : 1;
        if (a.ctl !== 'remote') a.x = clamp(a.x + s * ov / 2, 30, W - 30);
        if (b.ctl !== 'remote') b.x = clamp(b.x - s * ov / 2, 30, W - 30);
      }
    }
  }

  if (G.cine && ++G.cine.t >= G.cine.dur) G.cine = null;
  for (const p of G.projs) p.update();
  G.projs = G.projs.filter(p => !p.dead);
  FX.update();

  if (G.phase === 'fight' && ++G.frameCount % 60 === 0) {
    G.timer = Math.max(0, G.timer - 1);
    if (G.timer === 0) {
      const [fa, fb] = G.fighters;
      G.finish(fa.hp >= fb.hp ? 0 : 1);
    }
  }
  if (G.phase === 'end') { G.endT++; if (G.endT === 110) showResult(); }
  sendState();
}

function sendState() {
  if (Game.mode !== 'online' || !Game.running) return;
  const f = Game.me;
  Net.send({
    t: 's', x: Math.round(f.x), y: Math.round(f.y), f: f.face, s: f.state, st: f.st,
    m: f.moveName, ms: f.moveSeq, hp: f.hp, e: Math.round(f.energy), fm: f.form, ft: f.formT,
    iv: f.inv, cr: f.cdR, u: f.ultUsed ? 1 : 0
  });
}

