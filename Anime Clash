        }
        case 'txt':
          c.font = `${p.size}px Silkscreen, monospace`; c.textAlign = 'center'; c.lineWidth = 4; c.strokeStyle = '#090612';
          c.strokeText(p.s, p.x, p.y); c.fillStyle = p.col; c.fillText(p.s, p.x, p.y); break;
        case 'line': c.strokeStyle = p.col; c.lineWidth = p.w; c.beginPath(); c.moveTo(p.x1, p.y1); c.lineTo(p.x2, p.y2); c.stroke(); break;
