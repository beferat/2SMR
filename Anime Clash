const FX = {
  l: [],
  add(o) { o.t = 0; if (!o.life) o.life = 30; this.l.push(o); if (this.l.length > 1100) this.l.shift(); },
  burst(x, y, col, n = 12, spd = 4, life = 26, size = 4, g = 0.12) {
