<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Arena Umbral - Anime Clash</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Chakra+Petch:wght@400;600;700&display=swap">
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
:root{
  --ink:#0b0816;
  --panel:#171228;
  --panel2:#221a3a;
  --line:#3a2f58;
  --bone:#f5ede0;
  --mute:#9e92bc;
  --ember:#ff5533;
  --tide:#2ee6c8;
  --gold:#ffca58;
  --danger:#ff3355;
  --display:'Silkscreen', 'Courier New', monospace;
  --ui:'Chakra Petch', system-ui, sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;background:var(--ink);color:var(--bone);font-family:var(--ui);overflow:hidden;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
#app{position:fixed;inset:0;display:grid;place-items:center;
  padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px)}
#stage{position:relative;width:min(100vw,calc(100vh*16/9));width:min(100%,calc(100dvh*16/9));aspect-ratio:16/9;max-height:100%;
  container-type:size;background:#000;box-shadow:0 0 0 1px var(--line),0 30px 80px #000a}
#game{width:100%;height:100%;display:block;image-rendering:pixelated;image-rendering:crisp-edges;cursor:crosshair}
.screen{position:absolute;inset:0;overflow:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:2cqh;padding:3cqh 3cqw;background:linear-gradient(180deg,#0b0816dd,#0b0816f5)}
.screen[hidden]{display:none!important}
h1,h2,h3{font-family:var(--display);margin:0;letter-spacing:.04em;text-wrap:balance}
.logo{font-size:7cqw;line-height:.95;text-align:center;color:var(--bone);
  text-shadow:.35cqw .35cqw 0 var(--ember),.7cqw .7cqw 0 #4a1936}
.logo small{display:block;font-size:1.6cqw;letter-spacing:.5em;color:var(--gold);text-shadow:none;margin-top:1.4cqh}
.tagline{font-size:1.4cqw;color:var(--mute);margin:0;text-align:center;max-width:65ch}
.menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.4cqw;width:min(64cqw,100%)}
.menu-grid .wide{grid-column:1/-1}
.btn{font-family:var(--display);font-size:1.6cqw;color:var(--bone);background:var(--panel);border:.25cqw solid var(--line);
  padding:1.5cqh 1.5cqw;cursor:pointer;text-transform:uppercase;letter-spacing:.06em;position:relative;
  box-shadow:0 .5cqw 0 #07050d;transition:transform .08s, border-color .15s, background .15s}
.btn:hover,.btn:focus-visible{border-color:var(--ember);background:var(--panel2);outline:none}
.btn:active{transform:translateY(.4cqw);box-shadow:0 .1cqw 0 #07050d}
.btn.primary{background:var(--ember);border-color:#ff9e7d;color:#180a04}
.btn.primary:hover{background:#ff7457}
.btn.tide{border-color:var(--tide)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.join{display:flex;gap:1cqw}
.join input{flex:1;min-width:0;font-family:var(--display);font-size:1.9cqw;letter-spacing:.3em;text-transform:uppercase;text-align:center;
  background:#090612;color:var(--gold);border:.25cqw solid var(--line);padding:1.2cqh 1cqw}
.join input:focus{outline:none;border-color:var(--gold)}
.legend{display:flex;flex-wrap:wrap;gap:.6cqw 1.6cqw;justify-content:center;font-size:1.2cqw;color:var(--mute)}
.legend b,.kbd{font-family:var(--display);font-weight:400;color:var(--bone);background:var(--panel2);border:.15cqw solid var(--line);
  padding:.1cqh .6cqw;margin-right:.3cqw}
.note{font-size:1.2cqw;color:var(--mute);text-align:center;margin:0}
.note.err{color:var(--danger)}
.code{font-family:var(--display);font-size:8cqw;letter-spacing:.25em;color:var(--gold);text-shadow:.4cqw .4cqw 0 #4a1936;padding-left:.25em}
.row{display:flex;gap:1.2cqw;flex-wrap:wrap;justify-content:center}
#scr-select{justify-content:flex-start;padding-top:2.5cqh}
.sel-head{display:flex;justify-content:space-between;align-items:baseline;width:100%}
.sel-head h2{font-size:2.6cqw}
.sel-head .note{font-size:1.3cqw}
.sel-body{display:grid;grid-template-columns:1.35fr 1fr;gap:2cqw;width:100%;flex:1;min-height:0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1cqw;align-content:start}
.card{background:var(--panel);border:.25cqw solid var(--line);padding:.8cqh .6cqw;cursor:pointer;color:var(--bone);
  display:flex;flex-direction:column;align-items:center;gap:.4cqh;position:relative;font-family:var(--ui)}
.card canvas{width:100%;max-width:9cqw;aspect-ratio:96/120;image-rendering:pixelated}
.card .nm{font-family:var(--display);font-size:1.3cqw}
.card .tt{font-size:0.95cqw;color:var(--mute);text-align:center;line-height:1.1}
.card .tid{position:absolute;top:.5cqh;left:.5cqw;font-family:var(--display);font-size:.9cqw;color:var(--mute)}
.card .tf{position:absolute;top:.5cqh;right:.5cqw;font-family:var(--display);font-size:.9cqw;color:var(--gold)}
.card:hover,.card:focus-visible{border-color:var(--bone);outline:none}
.card.me{border-color:var(--ember);background:#2c1524}
.card.op{box-shadow:inset 0 0 0 .3cqw var(--tide)}
.card .who{position:absolute;top:2.6cqh;left:50%;transform:translateX(-50%);font-family:var(--display);font-size:.9cqw;padding:0 .4cqw}
.detail{background:var(--panel);border:.25cqw solid var(--line);padding:1.6cqh 1.6cqw;display:flex;flex-direction:column;gap:1cqh;min-width:0}
.detail-top{display:flex;gap:1.4cqw;align-items:center}
.detail canvas{width:11cqw;aspect-ratio:160/170;image-rendering:pixelated;background:#080512;border:.15cqw solid var(--line)}
.detail h3{font-size:2.2cqw}
.detail .sub{font-size:1.15cqw;color:var(--gold)}
.stats{display:grid;grid-template-columns:auto 1fr;gap:.4cqh .8cqw;font-size:1.0cqw;color:var(--mute);align-items:center;margin-top:.6cqh}
.bar{height:.8cqh;background:#080512;border:.1cqw solid var(--line)}
.bar i{display:block;height:100%;background:var(--ember)}
.moves{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.7cqh;font-size:1.1cqw}
.moves li{display:grid;grid-template-columns:3.4cqw 1fr;gap:.6cqw;align-items:start}
.moves .kbd{text-align:center;margin:0;font-size:1cqw;padding:.2cqh 0}
.sel-foot{display:flex;gap:1.2cqw;justify-content:space-between;align-items:center;width:100%}
#scr-result h2{font-size:7cqw}
#scr-result .win{color:var(--gold);text-shadow:.4cqw .4cqw 0 #4a1936}
#scr-result .lose{color:var(--mute)}
#touch{position:absolute;inset:0;pointer-events:none;display:none}
#touch.on{display:block}
.tpad{position:absolute;bottom:3cqh;display:grid;gap:1cqw;pointer-events:auto}
.tpad.l{left:2cqw;grid-template-columns:repeat(3,8cqw);grid-template-rows:repeat(2,8cqw)}
.tpad.r{right:2cqw;grid-template-columns:repeat(2,8.5cqw);grid-template-rows:repeat(2,8.5cqw)}
.tb{border-radius:50%;background:#ffffff14;border:.3cqw solid #ffffff40;color:#fff;font-family:var(--display);font-size:2.6cqw;
  display:grid;place-items:center;touch-action:none}
.tb.down{background:#ff553366;border-color:var(--ember)}
.tb.sm{font-size:2cqw}
#btn-mute{position:absolute;bottom:1.2cqh;right:1.2cqw;font-size:1.1cqw;padding:.6cqh .8cqw;z-index:5}
#toast{position:absolute;left:50%;top:4cqh;transform:translateX(-50%);background:var(--panel);border:.2cqw solid var(--ember);
  padding:1cqh 2cqw;font-size:1.4cqw;z-index:9;pointer-events:none}
#rotate{display:none}
@media (orientation:portrait) and (pointer:coarse){
  #rotate{display:grid;position:fixed;inset:0;place-items:center;background:var(--ink);z-index:99;text-align:center;padding:24px;font-family:var(--display);font-size:18px}
}
</style>
</head>
<body>
<div id="app">
  <div id="stage">
    <canvas id="game" width="960" height="540"></canvas>

    <div id="touch">
      <div class="tpad l">
        <span></span><button class="tb" data-code="KeyW" aria-label="Saltar">▲</button><span></span>
        <button class="tb" data-code="KeyA" aria-label="Izquierda">◀</button>
        <button class="tb sm" data-code="KeyS" aria-label="Guardia">⛨</button>
        <button class="tb" data-code="KeyD" aria-label="Derecha">▶</button>
      </div>
      <div class="tpad r">
        <button class="tb" data-code="KeyF">F</button>
        <button class="tb" data-code="KeyG">G</button>
        <button class="tb" data-code="KeyE">E</button>
        <button class="tb" data-code="KeyR">R</button>
      </div>
    </div>

    <!-- MENÚ -->
    <section class="screen" id="scr-menu">
      <h1 class="logo">ANIME CLASH<br><small>DUELO 1 VS 1 MULTIPLAYER</small></h1>
      <p class="tagline">Asta, Yuno, Luffy, Zoro, Eren y Mikasa. Combates online P2P o contra la máquina.</p>
      <div class="menu-grid">
        <button class="btn primary" id="b-host">Crear sala</button>
        <div class="join">
          <input id="in-code" maxlength="5" placeholder="CÓDIGO" autocomplete="off" aria-label="Código de sala">
          <button class="btn tide" id="b-join">Unirse</button>
        </div>
        <button class="btn wide" id="b-cpu">Práctica vs CPU</button>
      </div>
      <p class="note" id="menu-msg"></p>
      <div class="legend">
        <span><b>A</b><b>D</b>moverse</span><span><b>W</b>saltar</span><span><b>S</b>/<b>M2</b>guardia / parry</span>
        <span><b>E</b>/<b>M1</b>ataque</span><span><b>R</b>dash / proyectil</span><span><b>F</b>especial</span><span><b>G</b>transformación / definitiva</span>
      </div>
    </section>

    <!-- SALA -->
    <section class="screen" id="scr-lobby" hidden>
      <h2 style="font-size:2.4cqw">Código de sala</h2>
      <div class="code" id="lobby-code">·····</div>
      <div class="row">
        <button class="btn" id="b-copy">Copiar código</button>
        <button class="btn" id="b-lobby-back">Cancelar</button>
      </div>
      <p class="note" id="lobby-msg">Conectando con el servidor de señalización…</p>
    </section>

    <!-- SELECCIÓN -->
    <section class="screen" id="scr-select" hidden>
      <div class="sel-head">
        <h2>Elige luchador</h2>
        <p class="note" id="sel-status"></p>
      </div>
      <div class="sel-body">
        <div class="cards" id="cards"></div>
        <div class="detail" id="detail">
          <div class="detail-top">
            <canvas id="det-cv" width="160" height="170"></canvas>
            <div>
              <h3 id="det-name"></h3>
              <div class="sub" id="det-title"></div>
              <div class="stats" id="det-stats"></div>
            </div>
          </div>
          <ul class="moves" id="det-moves"></ul>
        </div>
      </div>
      <div class="sel-foot">
        <button class="btn" id="b-sel-back">Salir</button>
        <span class="note" id="sel-ping"></span>
        <button class="btn primary" id="b-ready">¡Listo!</button>
      </div>
    </section>

    <!-- RESULTADO -->
    <section class="screen" id="scr-result" hidden>
      <h2 id="res-title" class="win">VICTORIA</h2>
      <p class="tagline" id="res-sub"></p>
      <div class="row">
        <button class="btn primary" id="b-rematch">Revancha</button>
        <button class="btn" id="b-reselect">Cambiar luchador</button>
        <button class="btn" id="b-res-menu">Menú</button>
      </div>
      <p class="note" id="res-msg"></p>
    </section>

    <button class="btn" id="btn-mute" aria-label="Sonido">♪ ON</button>
    <div id="toast" hidden></div>
  </div>
</div>
<div id="rotate">Gira el móvil en horizontal para jugar</div>

