const SFX = {
  c: null, nb: null, m: null, muted: false,
  init() {
    if (this.c) { if (this.c.state === 'suspended') this.c.resume(); return; }
    try {
      this.c = new (window.AudioContext || window.webkitAudioContext)();
      const len = this.c.sampleRate * 0.6, b = this.c.createBuffer(1, len, this.c.sampleRate), d = b.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      this.nb = b; this.m = this.c.createGain(); this.m.gain.value = 0.32; this.m.connect(this.c.destination);
    } catch (e) { this.c = null; }
  },
  noise(dur, freq, type, vol, t0) {
    const c = this.c, s = c.createBufferSource(), f = c.createBiquadFilter(), g = c.createGain();
    s.buffer = this.nb; f.type = type; f.frequency.value = freq;
    g.gain.setValueAtTime(vol, t0); g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    s.connect(f); f.connect(g); g.connect(this.m); s.start(t0); s.stop(t0 + dur);
  },
  tone(f0, f1, dur, type, vol, t0) {
    const c = this.c, o = c.createOscillator(), g = c.createGain();
    o.type = type; o.frequency.setValueAtTime(f0, t0); o.frequency.exponentialRampToValueAtTime(f1, t0 + dur);
    g.gain.setValueAtTime(vol, t0); g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    o.connect(g); g.connect(this.m); o.start(t0); o.stop(t0 + dur);
  },
  play(k) {
    if (!this.c || this.muted) return;
    const t = this.c.currentTime;
    try {
      switch (k) {
        case 'whoosh': this.noise(0.14, 1800, 'bandpass', 0.35, t); break;
        case 'slash': this.noise(0.1, 3200, 'highpass', 0.3, t); break;
        case 'hit': this.noise(0.12, 900, 'lowpass', 0.8, t); this.tone(170, 50, 0.14, 'square', 0.22, t); break;
        case 'heavy': this.noise(0.28, 600, 'lowpass', 1, t); this.tone(120, 30, 0.3, 'square', 0.32, t); break;
        case 'block': this.tone(1300, 900, 0.07, 'square', 0.14, t); break;
        case 'proj': this.tone(420, 1300, 0.18, 'sawtooth', 0.1, t); break;
        case 'charge': this.tone(200, 760, 0.32, 'triangle', 0.16, t); break;
        case 'transform': this.tone(110, 880, 0.9, 'sawtooth', 0.18, t); this.noise(0.9, 380, 'lowpass', 0.45, t); break;
        case 'parry': this.tone(1600, 2600, 0.12, 'square', 0.15, t); this.noise(0.15, 5000, 'highpass', 0.45, t); break;
        case 'jump': this.tone(300, 520, 0.08, 'triangle', 0.08, t); break;
        case 'cine': this.tone(80, 640, 0.7, 'sawtooth', 0.14, t); break;
        case 'ko': this.tone(420, 40, 1.1, 'square', 0.28, t); break;
      }
    } catch(e) {}
  }
};

