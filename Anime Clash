      .map(([k, v]) => `<span>${k}</span><span class="bar"><i style="width:${Math.round(v * 100)}%"></i></span>`).join('');
    const mv = [['M2', d.desc.m2], ['E', d.desc.e], ['R', d.desc.r], ['F', d.desc.f], ['G', d.desc.g]];
    $('det-moves').innerHTML = mv.map(([k, s]) => `<li><span class="kbd">${k}</span><span>${s}</span></li>`).join('');
    $('b-ready').textContent = this.myReady ? 'Esperando rival…' : '¡Listo!';
    $('b-ready').disabled = this.myReady;
  },
  drawPreviews() {
    for (const p of this.previews) {
      const c = p.cv.getContext('2d'); c.clearRect(0, 0, 96, 120);
      drawFighter(c, p.f);
    }
    const detCv = $('det-cv'), c = detCv.getContext('2d'); c.clearRect(0, 0, 160, 170);
    const f = new Fighter(this.view, 0, 'preview'); f.x = 80; f.y = 150;
    f.form = Math.floor(T / 120) % 2 === 1;
    if (f.form && f.def.formBig) { c.save(); c.translate(80, 150); c.scale(0.72, 0.72); c.translate(-80, -150); }
    drawFighter(c, f);
    if (f.form && f.def.formBig) c.restore();
  },
  tryStart() {
    if (Game.mode !== 'online' || Net.role !== 'host') return;
    if (this.myReady && this.oppReady && this.opp) { Net.send({ t: 'start', a: this.my, b: this.opp }); startMatch(this.my, this.opp); }
  }
};

$('b-ready').onclick = () => {
  SFX.init();
  if (Game.mode === 'cpu') {
    const opp = ROSTER_IDS[Math.floor(Math.random() * ROSTER_IDS.length)];
    startMatch(Sel.my, opp);
    return;
  }
  Sel.myReady = true; Net.send({ t: 'pick', id: Sel.my }); Net.send({ t: 'ready', v: true }); Sel.render(); Sel.tryStart();
};
$('b-sel-back').onclick = () => { Net.close(); Game.mode = null; show('scr-menu'); };

function showResult() {
  const G = Game, w = G.winner;
  const t = $('res-title');
  t.textContent = w === G.me.side ? 'VICTORIA' : 'DERROTA';
  t.className = w === G.me.side ? 'win' : 'lose';
  $('res-sub').textContent = `${G.fighters[w].def.name} se alza con la victoria.`;
  show('scr-result');
}
$('b-rematch').onclick = () => {
  if (Game.mode === 'cpu') { startMatch(Sel.my, Game.opp.id); return; }
  Game.remMe = true; Net.send({ t: 'rematch' }); $('b-rematch').disabled = true; checkRematch();
};
$('b-reselect').onclick = () => { Game.running = false; if (Game.mode === 'online') Net.send({ t: 'toselect' }); Sel.reset(); show('scr-select'); };
$('b-res-menu').onclick = () => { Game.running = false; Net.close(); Game.mode = null; show('scr-menu'); };

/* ---------------- BUCLE PRINCIPAL ---------------- */
let acc = 0, last = performance.now();
const STEP = 1000 / 60;
function frame(now) {
  acc += Math.min(120, now - last); last = now;
  while (acc >= STEP) { step(); acc -= STEP; }
  render();
  if (!$('scr-select').hidden) Sel.drawPreviews();
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
</script>
</body>
