const ctx = cv.getContext('2d'); ctx.imageSmoothingEnabled = false;
function render() {
  const c = ctx, G = Game;
  c.save();
  if (G.shake > 0) { c.translate(Math.round(rnd(-G.shake, G.shake)), Math.round(rnd(-G.shake, G.shake))); G.shake *= 0.85; if (G.shake < 0.5) G.shake = 0; }
  c.drawImage(bg, 0, 0);

  if (G.running) {
    for (const f of G.fighters) {
      const w = f.big ? 60 : 26;
      c.fillStyle = '#00000055'; c.fillRect(Math.round(f.x - w), GROUND + 2, Math.round(w * 2), 5);
    }
    const order = [...G.fighters].sort((a, b) => (a.move ? 1 : 0) - (b.move ? 1 : 0));
    for (const f of order) drawFighter(c, f);
    for (const p of G.projs) p.draw(c);
  }
  FX.draw(c);
  c.restore();

  if (G.flash > 0) { c.fillStyle = `rgba(255,255,255,${G.flash / 16})`; c.fillRect(0, 0, W, H); G.flash--; }
  if (G.running) drawHUD(c);
  if (G.cine) drawCine(c, G.cine);
}

function drawCine(c, k) {
  const t = k.t, a = Math.min(1, t / 10, (k.dur - t) / 10);
  c.save(); c.globalAlpha = a;
  c.fillStyle = '#05030aaa'; c.fillRect(0, 160, W, 100);
  c.fillStyle = k.col; c.fillRect(0, 160, W, 4); c.fillRect(0, 256, W, 4);
  c.font = '36px Silkscreen'; c.fillStyle = '#ffffff'; c.textAlign = 'center';
  c.fillText(k.name, W / 2, 215);
  c.font = '14px Silkscreen'; c.fillStyle = k.col;
  c.fillText(k.sub, W / 2, 240);
  c.restore();
}

function drawHUD(c) {
  const G = Game, BW = 360;
  G.fighters.forEach((f, i) => {
    const left = i === 0, x = left ? 24 : W - 24 - BW, col = left ? '#ff5533' : '#2ee6c8';
    c.font = '16px Silkscreen'; c.fillStyle = '#f5ede0'; c.textAlign = left ? 'left' : 'right';
    c.fillText(f.def.name, left ? x : x + BW, 30);
    c.fillStyle = '#0d0818'; c.fillRect(x - 2, 38, BW + 4, 18);
    c.fillStyle = '#2a1a36'; c.fillRect(x, 40, BW, 14);
    const r = f.hp / f.def.hp, rl = f.hpLag / f.def.hp;
    c.fillStyle = '#f5ede0'; left ? c.fillRect(x + BW * (1 - rl), 40, BW * rl, 14) : c.fillRect(x, 40, BW * rl, 14);
    c.fillStyle = col; left ? c.fillRect(x + BW * (1 - r), 40, BW * r, 14) : c.fillRect(x, 40, BW * r, 14);
    const EW = 240, ex = left ? x : x + BW - EW;
    c.fillStyle = '#0d0818'; c.fillRect(ex - 2, 60, EW + 4, 10);
    c.fillStyle = '#1c142e'; c.fillRect(ex, 62, EW, 6);
    c.fillStyle = f.energy >= 100 ? '#ffca58' : '#e6a832';
    c.fillRect(left ? ex : ex + EW * (1 - f.energy / 100), 62, EW * f.energy / 100, 6);
    if (f.form) {
      c.font = '10px Silkscreen'; c.fillStyle = f.def.spark;
      c.fillText(f.def.formName, left ? ex : ex + EW, 82);
    }
  });

  c.fillStyle = '#0d0818'; c.fillRect(W / 2 - 34, 24, 68, 40);
  c.font = '24px Silkscreen'; c.fillStyle = '#ffca58'; c.textAlign = 'center';
  c.fillText(String(Math.ceil(G.timer)).padStart(2, '0'), W / 2, 53);

  if (G.phase === 'intro') {
    c.font = '60px Silkscreen'; c.fillStyle = '#ffca58'; c.textAlign = 'center';
    c.fillText('¡LUCHA!', W / 2, H / 2);
  }
}

