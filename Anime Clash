  },
  rise(x, y, col, size = 4) { this.add({ k: 'p', x, y, vx: rnd(-0.4, 0.4), vy: rnd(-2.6, -1), col, life: rnd(18, 34), size, g: -0.01 }); },
  ring(x, y, col, r = 50, life = 18, w = 5) { this.add({ k: 'ring', x, y, col, r, life, w }); },
  slash(x, y, dir, col, r = 50, flip = false, w = 6, col2 = null) { this.add({ k: 'slash', x, y, dir, col, r, flip, w, col2, life: col2 ? 16 : 12 }); },
  text(x, y, s, col, size = 20) { this.add({ k: 'txt', x, y, s, col, size, vx: 0, vy: -1.1, life: 48 }); },
  line(x1, y1, x2, y2, col, life = 12, w = 3) { this.add({ k: 'line', x1, y1, x2, y2, col, life, w }); },
  dust(x, y = GROUND, n = 14) {
    for (let i = 0; i < n; i++) { const s = i % 2 ? 1 : -1; this.add({ k: 'p', x: x + rnd(-10, 10), y: y - rnd(2, 8), vx: s * rnd(1, 4), vy: rnd(-2.5, -0.4), col: i % 3 ? '#6e6275' : '#94839c', life: rnd(18, 30), size: rnd(4, 7), g: 0.08 }); }
  },
  bolt(x, col) {
    const pts = []; let cx = x + rnd(-40, 40);
    for (let y = 0; y <= GROUND; y += 40) { pts.push([cx, y]); cx = x + rnd(-24, 24); }
    pts.push([x, GROUND]); this.add({ k: 'bolt', pts, col, life: 14 });
    this.burst(x, GROUND - 10, col, 16, 5, 20, 5, 0.1);
  },
  charge(x, y, col) {
    for (let i = 0; i < 18; i++) { const a = rnd(6.283), r = rnd(55, 90), life = 18; this.add({ k: 'p', x: x + Math.cos(a) * r, y: y + Math.sin(a) * r, vx: -Math.cos(a) * r / life, vy: -Math.sin(a) * r / life, col, life, size: 4, g: 0 }); }
