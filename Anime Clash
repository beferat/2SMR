/* ---------------- PROYECTILES ---------------- */
class Proj {
  constructor(owner, spec, ghost) {
    const d = PROJ[spec.kind];
    this.d = d; this.kind = spec.kind; this.owner = owner; this.ghost = ghost;
    this.dir = owner.face * (spec.dir || 1);
    this.x = owner.x + owner.face * (spec.dx || 0);
    this.cy = d.ground ? GROUND - d.h / 2 : owner.y + (spec.dy || -50);
    this.t = 0; this.dead = false; this.mul = owner.dmgMul(); this.lastHit = -99; this.vy = d.vy || 0;
  }
  box() { return { x: this.x - this.d.w / 2, y: this.cy - this.d.h / 2, w: this.d.w, h: this.d.h }; }
  update() {
    this.t++; this.x += this.d.vx * this.dir; this.cy += this.vy;
    const d = this.d;
    if (this.kind === 'meteor') {
      if (this.cy >= GROUND - d.h / 2) {
        this.dead = true; FX.dust(this.x, GROUND, 14); FX.burst(this.x, GROUND - 20, '#ffb35c', 18, 5, 22, 5, 0.12);
        Game.shake = Math.max(Game.shake, 6); SFX.play('heavy');
      }
    }
    if (this.t > d.life || this.x < -120 || this.x > W + 120) this.dead = true;
    if (this.ghost || this.dead) return;
    const tgt = Game.other(this.owner);
    if (!tgt || tgt.state === 'defeat' || tgt.inv > 0 || Game.phase !== 'fight') return;
    if (overlap(this.box(), tgt.hurt())) {
      const h = { ...d, dmg: d.dmg * this.mul };
      if (d.every) { if (this.t - this.lastHit >= d.every) { this.lastHit = this.t; applyHit(this.owner, tgt, h, this.dir, true); } }
      else { applyHit(this.owner, tgt, h, this.dir, true); this.dead = true; FX.burst(this.x, this.cy, d.col, 14, 4, 22, 5, 0); }
    }
  }
  draw(c) {
    const d = this.d, x = Math.round(this.x), y = Math.round(this.cy);
    c.save(); c.translate(x, y); c.scale(this.dir, 1);
    c.fillStyle = d.col;
    if (this.kind === 'windblade') {
      c.strokeStyle = d.col; c.lineWidth = 6; c.beginPath(); c.arc(-14, 0, 22, -1.2, 1.2); c.stroke();
    } else if (this.kind === 'tornado') {
      for (let i = 0; i < 8; i++) {
        const yy = d.h / 2 - (i / 7) * d.h, ww = d.w * (0.3 + 0.7 * (i / 7));
        c.strokeStyle = i % 2 ? '#ffffff' : d.col; c.lineWidth = 4;
        c.beginPath(); c.ellipse(Math.sin(this.t * 0.4 + i) * 6, yy, ww / 2, 5, 0, 0, 6.283); c.stroke();
      }
    } else {
      c.fillRect(-d.w / 2, -d.h / 2, d.w, d.h);
    }
    c.restore();
  }
}

/* ---------------- LUCHADOR (FIGHTER) ---------------- */
class Fighter {
  constructor(id, side, ctl) {
    this.def = ROSTER[id]; this.id = id; this.side = side; this.ctl = ctl;
    this.x = side === 0 ? 260 : 700; this.y = GROUND; this.vx = 0; this.vy = 0; this.face = side === 0 ? 1 : -1;
    this.hp = this.def.hp; this.hpLag = this.hp; this.energy = 0;
    this.state = 'idle'; this.st = 0; this.move = null; this.moveName = ''; this.moveSeq = 0;
    this.hitSet = new Set(); this.form = false; this.formT = 0; this.cdR = 0; this.stun = 0; this.inv = 0;
    this.onGround = true; this.jumpsLeft = this.def.jumps; this.flash = 0; this.buf = 0; this.holdT = 0; this.holdVx = 0;
    this.trailT = 0; this.trailCol = '#fff'; this.ghostT = 0; this.cycT = 0; this.cycCol = '#fff'; this.flurryT = 0; this.flurryCol = '#fff';
    this.combo = 0; this.lastHitT = -999; this.comboShow = 0; this.barrageT = 0; this.barrageCol = '#fff'; this.ultUsed = false;
    this.parryT = 0; this.parryCd = 0; this.dazeT = 0;
    this.tx = this.x; this.ty = this.y; this.vMove = null; this.vSt = 0; this.lastMs = -1;

    // Inercia independiente del grimorio de Yuno
    this.bookX = this.x - this.face * 28;
    this.bookY = this.y - 48;
  }
  get big() { return this.form && !!this.def.formBig; }
  get box() { return this.big ? this.def.formBox : this.def.box; }
  hurt() { const b = this.box; return { x: this.x - b.w / 2, y: this.y - b.h, w: b.w, h: b.h }; }
  moves() { return this.form && this.def.formMoves ? this.def.formMoves : this.def.moves; }
  moveDef(n) { return this.moves()[n] || this.def.moves[n] || (this.def.formMoves || {})[n] || null; }
  speed() { return this.form ? this.def.formSpeed : this.def.speed; }
  dmgMul() { return this.form ? (this.def.formDmg || 1) : 1; }
  worldBox(b) { return { x: this.face === 1 ? this.x + b[0] : this.x - b[0] - b[2], y: this.y + b[1], w: b[2], h: b[3] }; }
  snap() { return { def: this.def, id: this.id, side: this.side, form: this.form, face: this.face, state: this.state, st: this.st, move: this.move, moveName: this.moveName, x: this.x, y: this.y }; }

  startMove(name) {
    const m = this.moveDef(name); if (!m) return;
    this.move = m; this.moveName = name; this.moveSeq++;
    this.state = name.startsWith('atk') ? 'attack' : name === 'r' ? 'dash' : name === 'tf' ? 'transform' : 'special';
    this.st = -1; this.hitSet.clear(); this.holdT = 0; this.buf = 0;
    SFX.play(name === 'f' || name === 'ult' ? 'charge' : name === 'tf' ? 'transform' : 'whoosh');
  }

  update(inp, opp) {
    const d = this.def;
    if (this.flash > 0) this.flash--;
    if (this.cdR > 0) this.cdR--;
    if (this.inv > 0) this.inv--;
    if (this.buf > 0) this.buf--;
    if (this.parryT > 0) this.parryT--;
    if (this.parryCd > 0) this.parryCd--;
    if (this.dazeT > 0) this.dazeT--;
    if (this.state !== 'defeat' && Game.phase === 'fight') this.energy = Math.min(100, this.energy + 0.035);
    if (this.form) { this.formT--; if (this.formT <= 0) this.revert(); }

    if (this.state === 'defeat') { this.physics(); this.st++; return; }
    if (this.stun > 0) { this.stun--; if (this.stun === 0) this.state = this.onGround ? 'idle' : 'jump'; this.physics(); this.st++; return; }
    if (this.move) { this.runMove(inp, opp); this.physics(); this.st++; return; }

    if (inp.atk) this.startMove('atk1');
    else if (inp.r && this.cdR <= 0) { this.cdR = d.cdR; this.startMove('r'); }
    else if (inp.f && this.energy >= F_COST) { this.energy -= F_COST; this.startMove('f'); }
    else if (inp.g && d.canTransform && !this.form && this.energy >= 100) {
      this.energy = 0; this.vx = 0; this.startMove('tf');
    }
    else if (inp.g && this.form && !this.ultUsed && this.def.formMoves && this.def.formMoves.ult) {
      this.ultUsed = true; this.startMove('ult');
    }
    if (this.move) { this.physics(); this.st++; return; }

    if (inp.blockPress && this.onGround && this.parryCd <= 0) { this.parryT = 8; this.parryCd = 28; }
    const sp = this.speed(), mv = (inp.right ? 1 : 0) - (inp.left ? 1 : 0);
    if (inp.block && this.onGround) { if (this.state !== 'block') { this.state = 'block'; this.st = 0; } this.vx = 0; }
    else {
      this.vx = mv * sp;
      if (inp.jump && this.jumpsLeft > 0) {
        const jv = this.big ? 10 : d.jumpV;
        this.vy = -jv; this.jumpsLeft--; this.onGround = false; SFX.play('jump');
      }
      const ns = this.onGround ? (mv ? 'run' : 'idle') : 'jump';
      if (this.state !== ns) { this.state = ns; this.st = 0; }
    }
    if (this.onGround && opp) this.face = opp.x >= this.x ? 1 : -1;
    this.physics(); this.st++;
  }

  runMove(inp, opp) {
    const m = this.move, st = this.st;
    if (inp.atk) this.buf = 12;
    if (m.vel) for (const v of m.vel) if (st === v.f) {
      if (v.vx !== undefined) { this.vx = v.vx * this.face; this.holdT = v.hold || 0; this.holdVx = this.vx; }
      if (v.vy !== undefined) { this.vy = v.vy; this.onGround = false; }
    }
    if (this.holdT > 0) { this.vx = this.holdVx; this.holdT--; } else if (this.onGround) this.vx *= 0.8;
    if (m.inv && st === m.inv[0]) this.inv = m.inv[1] - m.inv[0];
    if (m.becomeAt === st && !this.form) this.becomeForm();
    if (m.tp && st === m.tp.f && opp) {
      const dir = opp.x >= this.x ? 1 : -1;
      this.x = clamp(opp.x + dir * 56, 40, W - 40); this.face = opp.x >= this.x ? 1 : -1;
      FX.burst(this.x, this.y - 40, this.def.spark, 14, 3, 18, 4, 0);
    }
    runTimeline(this, m, st, false);
    if (opp && Game.phase === 'fight') moveHits(this, opp);
    if (m.cancel && st >= m.cancel && this.buf > 0 && (this.moveName === 'atk1' || this.moveName === 'atk2')) {
      this.startMove(this.moveName === 'atk1' ? 'atk2' : 'atk3'); return;
