    this.add({ k: 'bolt', pts, col, life: 10 });
  },
  update() {
    for (const p of this.l) { p.t++; if (p.k === 'p' || p.k === 'txt') { p.x += p.vx; p.y += p.vy; if (p.g) p.vy += p.g; if (p.k === 'p') p.vx *= 0.96; } }
    this.l = this.l.filter(p => p.t < p.life);
  },
  draw(c) {
    for (const p of this.l) {
      const a = 1 - p.t / p.life; c.globalAlpha = Math.max(0, a);
      switch (p.k) {
        case 'p': { const s = Math.max(2, Math.round(p.size * (0.4 + 0.6 * a))); c.fillStyle = p.col; c.fillRect(Math.round(p.x - s / 2), Math.round(p.y - s / 2), s, s); break; }
        case 'ring': c.strokeStyle = p.col; c.lineWidth = p.w * a + 1; c.beginPath(); c.arc(p.x, p.y, p.r * (0.25 + 0.75 * (p.t / p.life)), 0, 6.283); c.stroke(); break;
        case 'slash': {
          const k = p.t / p.life, base = p.dir === 1 ? 0 : Math.PI, sw = 1.35;
          let a0 = base - sw, a1 = base + sw; if (p.flip) { const tmp = a0; a0 = a1; a1 = tmp; }
          const end = a0 + (a1 - a0) * Math.min(1, k * 3.2);
          if (p.col2) { c.strokeStyle = p.col2; c.lineWidth = p.w * 1.7 * (1 - k) + 3; c.beginPath(); c.arc(p.x, p.y, p.r + p.w * 0.3, Math.min(a0, end), Math.max(a0, end)); c.stroke(); }
          c.strokeStyle = p.col; c.lineWidth = p.w * (1 - k) + 2; c.beginPath(); c.arc(p.x, p.y, p.r, Math.min(a0, end), Math.max(a0, end)); c.stroke();
