    /* Obtener la plantilla semanal según la frecuencia del cuestionario */
    function getWeekPatternForProfile() {
      const freq = userProfile.frequency || '4';
      const focus = userProfile.focus || 'standard';

      // Días de la semana en JS: 0=Dom, 1=Lun, 2=Mar, 3=Mié, 4=Jue, 5=Vie, 6=Sáb
      if (freq === '3') {
        // Lun: Tirón, Mié: Empuje, Vie: Pierna & Core
        return ["rest", "pull", "rest", "push", "rest", "legs_core", "rest"];
      } else if (freq === '5') {
        if (focus === 'back_arms') {
          // Énfasis tirón: Lun: Tirón, Mar: Empuje, Mié: Pierna, Jue: Tirón (Chin-ups), Vie: Empuje/Torso
          return ["rest", "pull", "push", "legs_core", "pull", "torso", "rest"];
        }
        // PPL clásica 5 días: Lun: Tirón, Mar: Empuje, Mié: Pierna, Jue: Descanso, Vie: Tirón, Sáb: Empuje
        return ["rest", "pull", "push", "legs_core", "rest", "pull", "push"];
      } else {
        // 4 días (Recomendado estándar)
        if (focus === 'back_arms') {
          return ["rest", "pull", "push", "rest", "pull", "torso", "rest"];
        } else if (focus === 'lower_core') {
          return ["rest", "legs_core", "pull", "rest", "legs_core", "push", "rest"];
        }
        // Estándar 4 días: Lun: Tirón, Mar: Empuje, Jue: Pierna/Core, Vie: Torso
        return ["rest", "pull", "push", "rest", "legs_core", "torso", "rest"];
      }
    }

    /* Guardar y cargar datos */
    function loadSavedData() {
      try {
        const rawProfile = localStorage.getItem(STORAGE_KEY_PROFILE);
        if (rawProfile) {
          userProfile = { ...userProfile, ...JSON.parse(rawProfile) };
        } else {
          // Si nunca ha entrado, abrimos el onboarding automáticamente
          setTimeout(() => openOnboardingModal(false), 300);
        }

        const rawData = localStorage.getItem(STORAGE_KEY_DATA);
        if (rawData) {
          appData = JSON.parse(rawData);
        } else {
          appData = {};
        }
      } catch (e) {
        console.error("Error al cargar localStorage:", e);
      }
    }

    function saveToLocalStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_PROFILE, JSON.stringify(userProfile));
        localStorage.setItem(STORAGE_KEY_DATA, JSON.stringify(appData));
      } catch (e) {
        console.error("Error guardando:", e);
      }
    }

    function formatDateKey(year, monthIndex, day) {
      const m = String(monthIndex + 1).padStart(2, '0');
      const d = String(day).padStart(2, '0');
      return `${year}-${m}-${d}`;
    }

    /* Autoprogramar el mes con el patrón del cuestionario */
    function applyProfileRoutineToMonth() {
      const year = currentViewDate.getFullYear();
      const month = currentViewDate.getMonth();
      const totalDays = new Date(year, month + 1, 0).getDate();
      const pattern = getWeekPatternForProfile();

      for (let day = 1; day <= totalDays; day++) {
        const dateObj = new Date(year, month, day);
        const dayOfWeek = dateObj.getDay();
        const routineType = pattern[dayOfWeek];
        const key = formatDateKey(year, month, day);

        const prev = appData[key] || {};
        appData[key] = {
          routineType: routineType,
          status: routineType === 'rest' ? 'rest' : (prev.status || 'pending'),
          completedExercises: prev.completedExercises || {},
          notes: prev.notes || ""
        };
      }

      saveToLocalStorage();
      renderCalendar();
      updateMonthlyStats();
      showToast("Mes autoprogramado según tu perfil actual");
    }

    function populateMonthIfEmpty(year, monthIndex) {
      const totalDays = new Date(year, monthIndex + 1, 0).getDate();
      let hasEntries = false;

      for (let day = 1; day <= totalDays; day++) {
        const key = formatDateKey(year, monthIndex, day);
        if (appData[key]) {
          hasEntries = true;
          break;
        }
      }

      if (!hasEntries) {
        applyProfileRoutineToMonth();
      }
    }

