<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MesoCalisthenics Pro - Onboarding, Calendario & Tracker</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              lime: '#10b981',
              neon: '#22c55e',
              cyan: '#06b6d4',
              orange: '#f97316',
              amber: '#f59e0b',
              dark: '#0b1120',
              card: '#151f32',
              cardLight: '#1e293b',
              border: '#334155'
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Estilos personalizados y scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b1120;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  </style>
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen font-sans selection:bg-emerald-500 selection:text-black">

  <!-- Header Superior -->
  <header class="border-b border-slate-800/80 bg-slate-900/95 backdrop-blur sticky top-0 z-30 px-3 sm:px-8 py-3">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-500 flex items-center justify-center text-slate-950 shadow-lg shadow-emerald-500/20 font-black text-xl shrink-0">
          <i class="ph-bold ph-barbell text-2xl"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg sm:text-xl font-black tracking-tight bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
              MESO•CALISTHENICS
            </h1>
            <span id="userLevelBadge" class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 hidden sm:inline-block">
              Nivel: Intermedio
            </span>
          </div>
          <p class="text-[11px] sm:text-xs text-slate-400 font-medium">Entrenamiento en Casa para Mesomorfo (Barra de dominadas + Suelo)</p>
        </div>
      </div>

      <!-- Acciones de Cabecera -->
      <div class="flex items-center gap-2">
        <button onclick="openOnboardingModal(true)" class="px-3 py-1.5 rounded-xl border border-emerald-500/40 bg-emerald-950/30 hover:bg-emerald-900/40 text-xs font-semibold text-emerald-300 flex items-center gap-1.5 transition">
          <i class="ph ph-sliders text-base"></i>
          <span>Ajustar Perfil</span>
        </button>
        <button onclick="openGuideModal()" class="px-3 py-1.5 rounded-xl border border-slate-700 hover:border-slate-500 bg-slate-800 text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition">
          <i class="ph ph-book-open text-base text-cyan-400"></i>
          <span class="hidden sm:inline">Guía</span>
        </button>
        <button onclick="applyProfileRoutineToMonth()" class="px-3 py-1.5 rounded-xl border border-amber-500/40 bg-amber-950/30 hover:bg-amber-900/40 text-xs font-semibold text-amber-300 flex items-center gap-1.5 transition" title="Rellenar el mes actual según tus respuestas del perfil">
          <i class="ph ph-arrows-clockwise text-base"></i>
          <span class="hidden md:inline">Autoprogramar Mes</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Contenido Principal -->
  <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 space-y-8">
    
    <!-- Resumen del Perfil Actual Activo -->
    <section class="rounded-2xl bg-gradient-to-r from-slate-900 via-slate-900/90 to-slate-850 border border-slate-800 p-4 sm:p-5 relative overflow-hidden shadow-xl">
      <div class="absolute -right-8 -top-8 w-44 h-44 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1 text-[11px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-400">
              <i class="ph-fill ph-check-shield"></i> Perfil Personalizado Activo
            </span>
            <span id="profileFrequencyBadge" class="text-[11px] font-mono text-cyan-400 bg-cyan-950/40 border border-cyan-800/50 px-2 py-0.5 rounded-md">
              4 días / semana
            </span>
          </div>
          <h2 id="profileSummaryTitle" class="text-base sm:text-lg font-bold text-white">
            Plan Hipertrofia & Fuerza Calisténica
          </h2>
          <p id="profileSummaryDesc" class="text-xs text-slate-400 max-w-2xl leading-relaxed">
            Configuración adaptada a tu dominio de la barra de dominadas. Rutina balanceada para el físico mesomorfo con control del volumen semanal.
          </p>
        </div>

        <!-- Mini Tags de preferencias -->
        <div id="profileFavTags" class="flex flex-wrap gap-1.5 max-w-sm">
          <!-- Inyectado dinámicamente -->
        </div>
      </div>
    </section>

    <!-- Resumen Mensual & Métricas -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
          <i class="ph ph-chart-pie-slice text-emerald-400 text-lg"></i>
          Rendimiento & Proceso Mensual
        </h3>
        <span id="monthlyMonthLabel" class="text-xs font-semibold text-slate-300 font-mono"></span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <!-- Completados -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">Completados</span>
            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
              <i class="ph-bold ph-check text-sm"></i>
            </div>
          </div>
          <p id="statCompletedDays" class="text-2xl font-black text-white mt-2">0</p>
          <span class="text-[11px] text-emerald-400/90 font-medium" id="statCompletedSessions">sesiones finalizadas</span>
        </div>

        <!-- Adherencia -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">Adherencia</span>
            <div class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center">
              <i class="ph-bold ph-trend-up text-sm"></i>
            </div>
          </div>
          <p id="statAdherence" class="text-2xl font-black text-cyan-400 mt-2">0%</p>
          <span class="text-[11px] text-slate-400" id="statAdherenceSub">de los días programados</span>
        </div>

        <!-- Saltados -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">Saltados / No pude</span>
            <div class="w-7 h-7 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center">
              <i class="ph-bold ph-x text-sm"></i>
            </div>
          </div>
          <p id="statMissedDays" class="text-2xl font-black text-rose-400 mt-2">0</p>
          <span class="text-[11px] text-slate-400">recalendarizados</span>
        </div>

        <!-- Descansos -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">Descansos</span>
            <div class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
              <i class="ph-bold ph-moon text-sm"></i>
            </div>
          </div>
          <p id="statRestDays" class="text-2xl font-black text-indigo-300 mt-2">0</p>
          <span class="text-[11px] text-slate-400">recuperación activa</span>
        </div>
      </div>

      <!-- Barra de progreso visual mensual & Balance Muscular -->
      <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 space-y-4">
        <div>
          <div class="flex justify-between items-center text-xs mb-2">
            <span class="text-slate-300 font-semibold flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block"></span>
              Progreso del Mes en Curso
            </span>
            <span id="progressBarLabel" class="text-slate-400 font-mono">0 / 18 sesiones (0%)</span>
          </div>
          <div class="w-full bg-slate-950 h-3 rounded-full overflow-hidden p-0.5 border border-slate-800">
            <div id="progressBarFill" class="h-full bg-gradient-to-r from-emerald-500 to-cyan-400 rounded-full transition-all duration-500 w-0"></div>
          </div>
        </div>

        <!-- Balance muscular detallado -->
        <div class="pt-3 border-t border-slate-800/80">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Distribución Muscular Realizada</span>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex items-center justify-between">
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded bg-blue-500"></span> Tirón (Barra)
              </span>
              <span id="countPull" class="font-mono font-bold text-blue-400 text-sm">0</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex items-center justify-between">
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded bg-amber-500"></span> Empuje (Suelo)
              </span>
              <span id="countPush" class="font-mono font-bold text-amber-400 text-sm">0</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex items-center justify-between">
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded bg-purple-500"></span> Pierna & Core
              </span>
              <span id="countLegs" class="font-mono font-bold text-purple-400 text-sm">0</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex items-center justify-between">
              <span class="flex items-center gap-2 text-slate-300">
                <span class="w-2.5 h-2.5 rounded bg-teal-500"></span> Torso Completo
              </span>
              <span id="countTorso" class="font-mono font-bold text-teal-400 text-sm">0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Calendario Mensual Interactivo -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-slate-900 p-3 sm:p-4 rounded-2xl border border-slate-800">
        <!-- Navegación Mes / Año -->
        <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-start">
          <button onclick="changeMonth(-1)" class="p-2 rounded-xl border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 transition" aria-label="Mes anterior">
            <i class="ph-bold ph-caret-left text-lg"></i>
          </button>
          <div class="text-center px-4">
            <h2 id="calendarTitle" class="text-base sm:text-lg font-bold text-white capitalize">Mes Año</h2>
            <span class="text-[11px] text-slate-400">Haz clic en un día para registrar series o cambiarlo</span>
          </div>
          <button onclick="changeMonth(1)" class="p-2 rounded-xl border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 transition" aria-label="Mes siguiente">
            <i class="ph-bold ph-caret-right text-lg"></i>
          </button>
        </div>

        <!-- Leyenda interactiva -->
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-950/80 text-emerald-400 border border-emerald-700/50">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Completado
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-rose-950/80 text-rose-400 border border-rose-700/50">
            <span class="w-2 h-2 rounded-full bg-rose-400"></span> No pude
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 border border-slate-700">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span> Pendiente
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-indigo-950/80 text-indigo-300 border border-indigo-700/50">
            <span class="w-2 h-2 rounded-full bg-indigo-400"></span> Descanso
          </span>
        </div>
      </div>

      <!-- Cuadrícula -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl">
        <div class="calendar-grid bg-slate-950/90 border-b border-slate-800 text-center font-bold text-xs text-slate-400 py-3 uppercase tracking-wider">
          <div>Lun</div>
          <div>Mar</div>
          <div>Mié</div>
          <div>Jue</div>
          <div>Vie</div>
          <div>Sáb</div>
          <div>Dom</div>
        </div>

        <div id="calendarDaysGrid" class="calendar-grid p-1.5 sm:p-2 gap-1.5 sm:gap-2 min-h-[460px] bg-slate-950/40">
          <!-- Inyectado por JS -->
        </div>
      </div>
    </section>

    <!-- Informe de Evaluación de Fin de Mes -->
    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 space-y-4 shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="ph-bold ph-newspaper-clipping text-emerald-400 text-xl"></i>
          Diagnóstico y Resumen de Fin de Mes
        </h3>
        <button onclick="exportMonthlyReport()" class="text-xs bg-slate-800 hover:bg-slate-700 border border-slate-700 px-3 py-1.5 rounded-lg text-slate-200 flex items-center gap-1.5 transition">
          <i class="ph ph-copy"></i> Copiar Informe Completo
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-sm">
        <div class="space-y-3">
          <h4 class="font-semibold text-slate-200 flex items-center gap-2 text-xs uppercase tracking-wider">
            <i class="ph-fill ph-check-circle text-emerald-400"></i> Análisis Biomecánico para Mesomorfo:
          </h4>
          <div id="analysisRecommendation" class="text-slate-300 bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs sm:text-sm leading-relaxed">
            Completa o marca tus sesiones para desbloquear el diagnóstico adaptativo.
          </div>
        </div>

        <div class="space-y-3">
          <h4 class="font-semibold text-slate-200 flex items-center gap-2 text-xs uppercase tracking-wider">
            <i class="ph-fill ph-lightbulb text-amber-400"></i> Notas y Récords Recientes del Mes:
          </h4>
          <div id="monthlyNotesLog" class="bg-slate-950 p-4 rounded-xl border border-slate-800 max-h-48 overflow-y-auto space-y-2 text-xs text-slate-300">
            <!-- Inyectado con notas del mes -->
            <p class="text-slate-500 italic">No hay notas registradas todavía en este mes.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ==========================================
       MODAL 1: CUESTIONARIO / ONBOARDING INICIAL
       ========================================== -->
  <div id="onboardingModal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 flex items-center justify-center p-3 sm:p-5 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-2xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in duration-200">
      
      <!-- Encabezado del asistente -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-900/80">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
            <i class="ph-bold ph-sparkle"></i> Configuración Personalizada
          </span>
          <h3 class="text-lg font-black text-white">Perfil Mesomorfo & Calistenia en Casa</h3>
        </div>
        <button id="closeOnboardingBtn" onclick="closeOnboardingModal()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition hidden">
          <i class="ph-bold ph-x text-lg"></i>
        </button>
      </div>

      <!-- Cuerpo del cuestionario (Preguntas 1 a 5) -->
      <form id="onboardingForm" onsubmit="handleOnboardingSubmit(event)" class="p-5 sm:p-6 overflow-y-auto space-y-6 text-sm">
        
        <!-- P1: Nivel de Dominadas -->
        <div class="space-y-2.5">
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs">1</span>
            ¿Cuál es tu nivel actual con la barra de dominadas?
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <label class="relative border border-slate-800 bg-slate-950/70 p-3 rounded-xl cursor-pointer hover:border-emerald-500/60 transition flex flex-col justify-between">
              <input type="radio" name="pullupLevel" value="beginner" class="peer sr-only">
              <div>
                <span class="block text-xs font-bold text-white peer-checked:text-emerald-400">Principiante</span>
                <span class="block text-[11px] text-slate-400 mt-1">0 a 3 dominadas o negativas/asistidas con pie.</span>
              </div>
              <div class="mt-2 text-right">
                <span class="inline-block w-4 h-4 rounded-full border border-slate-700 peer-checked:bg-emerald-500 peer-checked:border-emerald-400"></span>
              </div>
            </label>

            <label class="relative border border-slate-800 bg-slate-950/70 p-3 rounded-xl cursor-pointer hover:border-emerald-500/60 transition flex flex-col justify-between">
              <input type="radio" name="pullupLevel" value="intermediate" checked class="peer sr-only">
              <div>
                <span class="block text-xs font-bold text-white peer-checked:text-emerald-400">Intermedio</span>
                <span class="block text-[11px] text-slate-400 mt-1">4 a 10 dominadas estrictas con barbilla sobre la barra.</span>
              </div>
              <div class="mt-2 text-right">
                <span class="inline-block w-4 h-4 rounded-full border border-slate-700 peer-checked:bg-emerald-500 peer-checked:border-emerald-400"></span>
              </div>
            </label>

            <label class="relative border border-slate-800 bg-slate-950/70 p-3 rounded-xl cursor-pointer hover:border-emerald-500/60 transition flex flex-col justify-between">
              <input type="radio" name="pullupLevel" value="advanced" class="peer sr-only">
              <div>
                <span class="block text-xs font-bold text-white peer-checked:text-emerald-400">Avanzado</span>
                <span class="block text-[11px] text-slate-400 mt-1">10+ dominadas, tempo lento o variaciones explosivas.</span>
              </div>
              <div class="mt-2 text-right">
                <span class="inline-block w-4 h-4 rounded-full border border-slate-700 peer-checked:bg-emerald-500 peer-checked:border-emerald-400"></span>
              </div>
            </label>
          </div>
        </div>

        <!-- P2: Objetivo Principal -->
        <div class="space-y-2.5">
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xs">2</span>
            ¿Cuál es tu objetivo prioritario?
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <label class="border border-slate-800 bg-slate-950/70 p-3 rounded-xl cursor-pointer hover:border-cyan-500/60 transition flex items-start gap-2.5">
              <input type="radio" name="goal" value="hypertrophy" checked class="mt-1 text-cyan-500 focus:ring-cyan-500">
              <div>
                <span class="font-bold text-xs text-white block">Hipertrofia & Densidad</span>
                <span class="text-[11px] text-slate-400">Espalda en V ancha, brazos y hombros rocosos.</span>
              </div>
            </label>

            <label class="border border-slate-800 bg-slate-950/70 p-3 rounded-xl cursor-pointer hover:border-cyan-500/60 transition flex items-start gap-2.5">
              <input type="radio" name="goal" value="strength" class="mt-1 text-cyan-500 focus:ring-cyan-500">
              <div>
                <span class="font-bold text-xs text-white block">Fuerza & Control</span>
                <span class="text-[11px] text-slate-400">Subir repeticiones estrictas y estabilidad escapular.</span>
              </div>
            </label>

            <label class="border border-slate-800 bg-slate-950/70 p-3 rounded-xl cursor-pointer hover:border-cyan-500/60 transition flex items-start gap-2.5">
              <input type="radio" name="goal" value="endurance" class="mt-1 text-cyan-500 focus:ring-cyan-500">
              <div>
                <span class="font-bold text-xs text-white block">Definición & Resistencia</span>
                <span class="text-[11px] text-slate-400">Series en superserie con menor descanso.</span>
              </div>
            </label>
          </div>
        </div>

        <!-- P3: Frecuencia Semanal -->
        <div class="space-y-2.5">
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center text-xs">3</span>
            Frecuencia semanal deseada:
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <label class="border border-slate-800 bg-slate-950/70 p-3 rounded-xl cursor-pointer hover:border-amber-500/60 transition">
              <div class="flex items-center gap-2">
                <input type="radio" name="frequency" value="3" class="text-amber-500 focus:ring-amber-500">
                <span class="font-bold text-xs text-white">3 Días / sem</span>
              </div>
