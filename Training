    function renderModalExerciseList(routineType, completedMap) {
      const container = document.getElementById('exerciseList');
      container.innerHTML = '';
      const library = getExerciseLibraryByProfile();
      const routine = library[routineType] || library['pull'];

      if (!routine.exercises || routine.exercises.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-400 italic">No hay ejercicios predefinidos para este tipo.</p>`;
        return;
