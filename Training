      if (form.elements['goal']) form.elements['goal'].value = userProfile.goal || 'hypertrophy';
      if (form.elements['frequency']) form.elements['frequency'].value = userProfile.frequency || '4';
      if (form.elements['focus']) form.elements['focus'].value = userProfile.focus || 'standard';

      // Checkboxes
      const favCheckboxes = form.querySelectorAll('input[name="favExercises"]');
      favCheckboxes.forEach(cb => {
