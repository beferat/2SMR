    /* =====================================================================
       MÉTRICAS & EVALUACIÓN MENSUAL
       ===================================================================== */
    function updateMonthlyStats() {
      const year = currentViewDate.getFullYear();
      const monthIndex = currentViewDate.getMonth();
      const totalDays = new Date(year, monthIndex + 1, 0).getDate();

      let completed = 0;
      let missed = 0;
      let rest = 0;
      let pending = 0;

      const routines = { pull: 0, push: 0, legs_core: 0, torso: 0, custom: 0 };
      const notesList = [];

      for (let day = 1; day <= totalDays; day++) {
        const key = formatDateKey(year, monthIndex, day);
        const item = appData[key];
        if (!item) continue;

        if (item.status === 'completed') {
          completed++;
          if (routines[item.routineType] !== undefined) {
            routines[item.routineType]++;
          } else {
            routines.custom++;
          }
        } else if (item.status === 'missed') {
          missed++;
        } else if (item.status === 'rest') {
          rest++;
        } else {
          pending++;
        }

        if (item.notes && item.notes.trim() !== '') {
          notesList.push({ day, note: item.notes, routine: item.routineType, status: item.status });
        }
      }

      // Actualizar contadores
      document.getElementById('statCompletedDays').textContent = completed;
      document.getElementById('statMissedDays').textContent = missed;
      document.getElementById('statRestDays').textContent = rest;

      document.getElementById('countPull').textContent = routines.pull;
      document.getElementById('countPush').textContent = routines.push;
      document.getElementById('countLegs').textContent = routines.legs_core;
      document.getElementById('countTorso').textContent = routines.torso;

      const plannedDone = completed + missed;
      const adherence = plannedDone > 0 ? Math.round((completed / plannedDone) * 100) : 0;
      document.getElementById('statAdherence').textContent = `${adherence}%`;
      document.getElementById('statAdherenceSub').textContent = `${completed} de ${plannedDone} previstos`;

      // Barra de progreso mensual (Meta según frecuencia elegida)
      const weeklyDays = parseInt(userProfile.frequency || '4', 10);
      const monthlyTargetSessions = weeklyDays * 4; // ~4 semanas
      const progressPercent = Math.min(100, Math.round((completed / monthlyTargetSessions) * 100));
      document.getElementById('progressBarFill').style.width = `${progressPercent}%`;
      document.getElementById('progressBarLabel').textContent = `${completed} / ${monthlyTargetSessions} objetivo (${progressPercent}%)`;

      // Diagnóstico para mesomorfo
      renderMonthlyDiagnostic(completed, missed, adherence, routines);

      // Renderizar notas del mes
      renderNotesLog(notesList);
    }

    function renderMonthlyDiagnostic(completed, missed, adherence, routines) {
      const el = document.getElementById('analysisRecommendation');
      if (completed === 0 && missed === 0) {
        el.innerHTML = "Aún no has registrado sesiones en este mes. Haz clic en el día actual para marcar tu entrenamiento y empezar a registrar tu progreso.";
        return;
      }

      let text = "";
      if (adherence >= 85) {
        text += `<span class="text-emerald-400 font-bold">¡Adherencia sobresaliente (${adherence}%)!</span> Como mesomorfo, estás en la zona de máxima hipertrofia miofibrilar. Tu síntesis proteica está en su punto más eficiente. Si las dominadas o flexiones ya superan 12-15 repeticiones fluidas, añade variantes con pausa isométrica de 2 segundos en el pico de contracción.`;
      } else if (adherence >= 65) {
        text += `<span class="text-amber-400 font-bold">Consistencia moderada (${adherence}%).</span> Has mantenido la base, pero los días saltados (${missed}) reducen el volumen total. Intenta utilizar los días de 'Torso Completo' de 30 minutos cuando tengas poco tiempo para no perder el estímulo de la barra.`;
      } else {
        text += `<span class="text-rose-400 font-bold">Adherencia baja (${adherence}%).</span> Tienes ${missed} sesiones saltadas este mes. Te sugerimos ajustar tu perfil en 'Ajustar Perfil' a 3 días semanales para crear un hábito inquebrantable antes de subir a 4 o 5 días.`;
      }

      // Balance empuje vs tirón
      const diff = Math.abs(routines.pull - routines.push);
      if (diff > 2) {
        text += `<br><span class="text-cyan-400 font-semibold mt-2 block">Aviso de simetría:</span> Has hecho ${routines.pull} de tirón vs ${routines.push} de empuje. Equilibra ambas para evitar rotación interna de hombros.`;
      }

      el.innerHTML = text;
    }

    function renderNotesLog(notesList) {
      const container = document.getElementById('monthlyNotesLog');
      if (notesList.length === 0) {
        container.innerHTML = `<p class="text-slate-500 italic">No hay notas registradas todavía en este mes.</p>`;
        return;
      }

      container.innerHTML = notesList.map(n => `
        <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 flex items-start justify-between gap-2">
          <div>
            <span class="font-bold text-slate-200">Día ${n.day}:</span>
            <span class="text-slate-300 ml-1">${n.note}</span>
          </div>
          <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 shrink-0">${n.routine}</span>
        </div>
      `).join('');
    }

