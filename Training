      routine.exercises.forEach(ex => {
        const isChecked = !!completedMap[ex.id];
        const item = document.createElement('div');
        item.className = `p-3 rounded-xl border flex items-start justify-between gap-3 transition ${
          isChecked ? 'bg-emerald-950/30 border-emerald-700/60' : 'bg-slate-950 border-slate-800 hover:border-slate-700'
        }`;

        item.innerHTML = `
          <div class="flex-1 space-y-0.5">
            <span class="text-xs font-bold text-slate-200 block">${ex.name}</span>
            <span class="text-[11px] font-semibold text-emerald-400 font-mono block">${ex.target}</span>
            <p class="text-[11px] text-slate-400 leading-tight">${ex.tips}</p>
          </div>
          <label class="cursor-pointer flex items-center pt-0.5">
            <input type="checkbox" data-ex-id="${ex.id}" ${isChecked ? 'checked' : ''} onchange="toggleExerciseItem(this)" class="w-5 h-5 rounded-md text-emerald-500 bg-slate-900 border-slate-700 focus:ring-emerald-400 focus:ring-offset-slate-950">
          </label>
        `;

        container.appendChild(item);
      });
    }

    function toggleExerciseItem(checkbox) {
      const parent = checkbox.closest('.border');
      if (checkbox.checked) {
        parent.classList.add('bg-emerald-950/30', 'border-emerald-700/60');
        parent.classList.remove('bg-slate-950', 'border-slate-800');
        if (activeModalStatus === 'pending') {
          setDayStatus('completed');
        }
      } else {
        parent.classList.remove('bg-emerald-950/30', 'border-emerald-700/60');
        parent.classList.add('bg-slate-950', 'border-slate-800');
      }
    }

    /* Mover el entrenamiento de hoy a mañana */
    function postponeCurrentWorkoutToTomorrow() {
      if (!activeModalDayKey) return;
      const [year, month, day] = activeModalDayKey.split('-').map(Number);
      const currentDateObj = new Date(year, month - 1, day);
      
      const tomorrowObj = new Date(currentDateObj);
      tomorrowObj.setDate(tomorrowObj.getDate() + 1);
      const tomorrowKey = formatDateKey(tomorrowObj.getFullYear(), tomorrowObj.getMonth(), tomorrowObj.getDate());

      const currentRoutine = document.getElementById('routineSelect').value;

      // Marcamos hoy como saltado / descanso
      activeModalStatus = 'missed';
      updateModalStatusButtons();

      // Programamos mañana con la rutina de hoy
      const prevTomorrow = appData[tomorrowKey] || {};
      appData[tomorrowKey] = {
        routineType: currentRoutine,
        status: 'pending',
        completedExercises: prevTomorrow.completedExercises || {},
        notes: (prevTomorrow.notes ? prevTomorrow.notes + ' ' : '') + `[Pospuesto del día ${day}]`
      };

      saveDayModal();
      showToast(`Rutina movida exitosamente al día ${tomorrowObj.getDate()}`);
    }

    function saveDayModal() {
      if (!activeModalDayKey) return;

      const routineType = document.getElementById('routineSelect').value;
      const notes = document.getElementById('modalNotes').value;

      const completed = {};
      document.querySelectorAll('#exerciseList input[type="checkbox"]').forEach(cb => {
        const id = cb.getAttribute('data-ex-id');
        if (id) completed[id] = cb.checked;
      });

      appData[activeModalDayKey] = {
        routineType: routineType,
        status: activeModalStatus,
        completedExercises: completed,
        notes: notes
      };

      saveToLocalStorage();
      closeDayModal();
      renderCalendar();
      updateMonthlyStats();
      showToast("Día actualizado correctamente");
    }

    function deleteDayRecord() {
      if (!activeModalDayKey) return;
      delete appData[activeModalDayKey];
      saveToLocalStorage();
      closeDayModal();
      renderCalendar();
      updateMonthlyStats();
      showToast("Registro restablecido");
    }

    /* =====================================================================
       GUÍA & UTILIDADES
       ===================================================================== */
    function openGuideModal() {
      document.getElementById('guideModal').classList.remove('hidden');
    }

    function closeGuideModal() {
      document.getElementById('guideModal').classList.add('hidden');
    }

    function showToast(msg) {
      const el = document.getElementById('toastMessage');
      document.getElementById('toastText').textContent = msg;
      el.classList.remove('translate-y-24', 'opacity-0');
      el.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        el.classList.remove('translate-y-0', 'opacity-100');
        el.classList.add('translate-y-24', 'opacity-0');
      }, 2500);
    }

    function exportMonthlyReport() {
      const year = currentViewDate.getFullYear();
      const month = currentViewDate.getMonth();
      const monthLabel = `${MONTH_NAMES[month]} ${year}`;

      const completed = document.getElementById('statCompletedDays').textContent;
      const missed = document.getElementById('statMissedDays').textContent;
      const rest = document.getElementById('statRestDays').textContent;
      const adherence = document.getElementById('statAdherence').textContent;
      const pull = document.getElementById('countPull').textContent;
      const push = document.getElementById('countPush').textContent;
      const legs = document.getElementById('countLegs').textContent;

      const text = `📊 INFORME DE ENTRENAMIENTO MESOMORFO - ${monthLabel}\n` +
        `-----------------------------------------\n` +
        `• Nivel de barra: ${userProfile.pullupLevel}\n` +
        `• Meta: ${userProfile.goal}\n` +
        `• Sesiones completadas: ${completed}\n` +
        `• Sesiones no realizadas: ${missed}\n` +
        `• Días de descanso: ${rest}\n` +
        `• Tasa de adherencia: ${adherence}\n` +
        `• Desglose muscular: Tirón (${pull}) | Empuje (${push}) | Pierna/Core (${legs})\n` +
        `• Equipamiento: Barra de dominadas + Calistenia en suelo\n` +
        `-----------------------------------------\n` +
        `¡Generado por MesoCalisthenics Tracker!`;

      const tempArea = document.createElement("textarea");
      tempArea.value = text;
      document.body.appendChild(tempArea);
      tempArea.select();
      try {
        document.execCommand('copy');
        showToast("¡Informe mensual copiado al portapapeles!");
      } catch (err) {
        showToast("Error al copiar texto");
      }
      document.body.removeChild(tempArea);
    }

    /* Teclas de acceso rápido */
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDayModal();
        closeGuideModal();
        closeOnboardingModal();
      }
    });

    /* Inicialización */
    window.addEventListener('DOMContentLoaded', () => {
      loadSavedData();
      updateProfileUIHeader();
      renderCalendar();
      updateMonthlyStats();
    });
  </script>
</body>
</html>
