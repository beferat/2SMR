    function getCellStyles(status, isToday) {
      let base = "border-slate-800 bg-slate-900/60 hover:border-slate-600 hover:bg-slate-800/80";

      if (status === 'completed') {
        base = "border-emerald-700/60 bg-emerald-950/30 hover:border-emerald-500 hover:bg-emerald-950/50";
      } else if (status === 'missed') {
        base = "border-rose-800/60 bg-rose-950/20 hover:border-rose-600 hover:bg-rose-950/40";
      } else if (status === 'rest') {
        base = "border-slate-800/80 bg-slate-900/40 text-slate-400 hover:border-indigo-800/60 hover:bg-indigo-950/20";
      }

      if (isToday) {
        base += " ring-2 ring-emerald-400 ring-offset-2 ring-offset-slate-950";
      }

      return base;
    }

    function getStatusIconHtml(status) {
      if (status === 'completed') {
        return `<span class="text-emerald-400" title="Completado"><i class="ph-fill ph-check-circle text-base"></i></span>`;
      }
      if (status === 'missed') {
        return `<span class="text-rose-400" title="Saltado / No pude"><i class="ph-fill ph-x-circle text-base"></i></span>`;
      }
      if (status === 'rest') {
        return `<span class="text-indigo-400" title="Descanso"><i class="ph-fill ph-moon text-sm"></i></span>`;
      }
      return `<span class="text-slate-600" title="Pendiente"><i class="ph ph-circle text-sm"></i></span>`;
    }

