/* ===================== DETECCIÓN WEBGPU ===================== */
async function detectGPU(){
  if(!('gpu' in navigator)){
    $('#gpuDot').className='dot err'; $('#gpuName').textContent='no disponible';
    log('WebGPU NO soportado en este navegador. Usa Chrome/Edge 113+ o Safari 18+.','err');
    toast('⚠ WebGPU no disponible — el motor LLM necesita WebGPU.');
    return false;
  }
  try{
    const adapter = await navigator.gpu.requestAdapter();
    if(!adapter){ $('#gpuDot').className='dot warn'; $('#gpuName').textContent='sin adaptador'; log('requestAdapter() devolvió null.','warn'); return false; }
    let info={};
    try{ info = adapter.info || (adapter.requestAdapterInfo ? await adapter.requestAdapterInfo() : {}); }catch(e){}
    const name = info.description || info.vendor || info.architecture || 'adaptador activo';
    $('#gpuDot').className='dot ok'; $('#gpuName').textContent=name;
    log(`WebGPU OK · ${name}`,'ok');
    const L=adapter.limits||{};
    log(`Límites GPU · maxBufferSize=${(L.maxBufferSize/1048576|0)}MB · maxComputeWorkgroups=${L.maxComputeWorkgroupsPerDimension||'?'}`,'gpu');
    return true;
  }catch(e){ $('#gpuDot').className='dot err'; $('#gpuName').textContent='error'; log('Error WebGPU: '+e.message,'err'); return false; }
}

/* ---------- Monitor de RAM ---------- */
setInterval(()=>{
  if(performance.memory){
    const u=performance.memory.usedJSHeapSize/1048576, t=performance.memory.jsHeapSizeLimit/1048576;
    $('#ramVal').textContent=`${u|0}/${t|0}MB`;
  } else $('#ramVal').textContent='n/d';
},1800);

/* ===================== CARGA DE MODELO (WebLLM) ===================== */
function populateModels(){
  const sel=$('#modelSel');
  const list=(webllm.prebuiltAppConfig?.model_list||[]).map(m=>m.model_id);
  // Preferencia: modelos instruct compactos
  const pref=['Llama-3.2-1B-Instruct-q4f32_1-MLC','Llama-3.2-1B-Instruct-q4f16_1-MLC',
    'Qwen2.5-1.5B-Instruct-q4f16_1-MLC','Qwen2.5-0.5B-Instruct-q4f16_1-MLC',
    'SmolLM2-1.7B-Instruct-q4f16_1-MLC','gemma-2-2b-it-q4f16_1-MLC',
    'Phi-3.5-mini-instruct-q4f16_1-MLC','Llama-3.2-3B-Instruct-q4f16_1-MLC'];
  const ordered=[...pref.filter(x=>list.includes(x)),
                 ...list.filter(x=>/instruct|-it-|chat/i.test(x) && !pref.includes(x))];
  if(ordered.length===0 && list.length) ordered.push(...list);
  sel.innerHTML='';
  ordered.forEach(id=>{const o=el('option');o.value=id;o.textContent=id.replace(/-MLC$/,'').replace(/-q4f\d+_\d+/,'');sel.appendChild(o);});
  if(!ordered.length){const o=el('option');o.textContent='sin modelos';sel.appendChild(o);}
  log(`Catálogo WebLLM: ${list.length} modelos disponibles.`,'info');
}

async function loadModel(){
  if(state.loading) return;
  const id=$('#modelSel').value;
  if(!id){toast('No hay modelo seleccionado');return;}
  state.loading=true; $('#loadBtn').disabled=true; $('#modelSel').disabled=true;
  $('#engDot').className='dot warn'; $('#engState').textContent='cargando';
  $('#loadFill').classList.remove('indet');
  log(`Cargando modelo «${id}»… (primera vez: descarga + compilación de shaders)`,'gpu');
  try{
    state.engine = await webllm.CreateMLCEngine(id,{
      initProgressCallback:(r)=>{
        const pct=Math.round((r.progress||0)*100);
        $('#loadFill').style.width=pct+'%'; $('#loadPct').textContent=pct+'%';
        $('#loadText').textContent=(r.text||'').slice(0,60);
        if(pct%5===0) log(r.text||'…','info');
      }
    });
    state.modelId=id;
    $('#engDot').className='dot ok'; $('#engState').textContent='listo';
    $('#loadFill').style.width='100%'; $('#loadPct').textContent='100%'; $('#loadText').textContent='Modelo en caché · listo';
    log(`Modelo «${id}» cargado y residente en GPU. Caché local activa.`,'ok');
    toast('✅ Núcleo IA operativo');
  }catch(e){
    $('#engDot').className='dot err'; $('#engState').textContent='error';
    log('Fallo al cargar modelo: '+e.message,'err');
    toast('❌ Error al cargar el modelo');
  }finally{
    state.loading=false; $('#loadBtn').disabled=false; $('#modelSel').disabled=false;
  }
}
$('#loadBtn').onclick=loadModel;

/* ===================== CHAT / STREAMING ===================== */
const chatEl=$('#chat');
function removeWelcome(){const w=$('#welcome');if(w)w.remove();}

function addMessage(role){
  removeWelcome();
  const wrap=el('div','msg '+(role==='user'?'user':role==='system'?'sys':'ai'));
  const av=el('div','av'); av.textContent=role==='user'?'TÚ':role==='system'?'SYS':'AI';
  const bub=el('div','bubble');
  const who=el('div','who');
  who.innerHTML = role==='user'?'Usuario':role==='system'?'Sistema':
    `NEXUS <span class="modebadge">· ${MODES[currentMode].name}</span>`;
  const content=el('div','content');
  bub.appendChild(who); bub.appendChild(content);
  wrap.appendChild(av); wrap.appendChild(bub);
  chatEl.appendChild(wrap);
  chatEl.scrollTop=chatEl.scrollHeight;
  return content;
}

function renderMarkdown(container,text,streaming){
  const raw = (window.marked?marked.parse(text):esc(text));
  container.innerHTML = window.DOMPurify?DOMPurify.sanitize(raw):raw;
  if(streaming){const c=el('span','cursor');container.appendChild(c);}
  else decorateCode(container);
}
function decorateCode(container){
  container.querySelectorAll('pre code').forEach(code=>{
    if(window.hljs){try{hljs.highlightElement(code);}catch(e){}}
    const pre=code.parentElement;
    if(pre.querySelector('.codebar'))return;
    const bar=el('div','codebar');
    const btn=el('button','copybtn'); btn.textContent='copiar';
    btn.onclick=()=>{navigator.clipboard.writeText(code.textContent).then(()=>{btn.textContent='✓ copiado';setTimeout(()=>btn.textContent='copiar',1400);});};
    bar.appendChild(btn); pre.appendChild(bar);
  });
}

function buildContext(){
  const sys={role:'system',content:MODES[currentMode].sys};
  const recent=state.messages.slice(-10); // ventana de contexto
  return [sys,...recent];
}

async function send(text){
  text=(text||$('#prompt').value).trim();
  if(!text) return;
  if(!state.engine){toast('Carga un modelo primero (⚡ Cargar)');log('Intento de envío sin modelo cargado.','warn');return;}
  if(state.generating) return;

  $('#prompt').value=''; autoGrow();
  addMessage('user').textContent=text;
  state.messages.push({role:'user',content:text});

  const out=addMessage('ai');
  state.generating=true; $('#sendBtn').style.display='none'; $('#stopBtn').style.display='grid';
  $('#actDot').className='dot live'; $('#engState').textContent='generando'; $('#engDot').className='dot live';

  let full=''; let n=0; const t0=performance.now();
  try{
    const stream=await state.engine.chat.completions.create({
      messages:buildContext(),
      temperature:parseFloat($('#temp').value),
      top_p:parseFloat($('#topp').value),
      max_tokens:parseInt($('#maxtok').value),
      stream:true, stream_options:{include_usage:true}
    });
    for await (const chunk of stream){
      const d=chunk.choices?.[0]?.delta?.content||'';
      if(d){ full+=d; n++; renderMarkdown(out,full,true); chatEl.scrollTop=chatEl.scrollHeight;
        if(n%6===0){const s=(performance.now()-t0)/1000; $('#tps').textContent=(n/s).toFixed(1);} }
      if(chunk.usage){
        $('#tokTotal').textContent=chunk.usage.total_tokens??n;
        log(`Uso · prompt=${chunk.usage.prompt_tokens} · generado=${chunk.usage.completion_tokens} · total=${chunk.usage.total_tokens}`,'gpu');
      }
    }
    renderMarkdown(out,full,false);
    state.messages.push({role:'assistant',content:full});
    const s=(performance.now()-t0)/1000; $('#tps').textContent=(n/s).toFixed(1);
    log(`Respuesta completada · ${n} fragmentos · ${(n/s).toFixed(1)} tok/s aprox.`,'ok');

    addSpeakButton(out,full);
    if($('#autotts').checked) speak(full);
    if(currentMode==='music') tryPlayFromText(full);
    saveSession();
  }catch(e){
    renderMarkdown(out, full || ('⚠ Error de generación: '+e.message), false);
    log('Error en generación: '+e.message,'err');
  }finally{
    state.generating=false; $('#sendBtn').style.display='grid'; $('#stopBtn').style.display='none';
    $('#actDot').className='dot'; $('#engState').textContent='listo'; $('#engDot').className='dot ok';
  }
}
$('#sendBtn').onclick=()=>send();
$('#stopBtn').onclick=()=>{ if(state.engine && state.generating){ try{state.engine.interruptGenerate();log('Generación interrumpida por el usuario.','warn');}catch(e){} } };

/* input autoexpandible + enter */
const prompt=$('#prompt');
function autoGrow(){prompt.style.height='auto';prompt.style.height=Math.min(prompt.scrollHeight,180)+'px';}
prompt.addEventListener('input',autoGrow);
prompt.addEventListener('keydown',e=>{ if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send();} });
document.querySelectorAll('.pill').forEach(p=>p.onclick=()=>{prompt.value=p.dataset.q;autoGrow();prompt.focus();});

/* ===================== TTS (síntesis de voz) ===================== */
function speak(text){
  if(!('speechSynthesis' in window)){log('speechSynthesis no soportado.','warn');return;}
  const clean=text.replace(/```[\s\S]*?```/g,' bloque de código ').replace(/[#*_`>|]/g,'').slice(0,600);
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(clean);
  const vs=speechSynthesis.getVoices();
  const es=vs.find(v=>/es/i.test(v.lang)); if(es)u.voice=es; u.lang=es?es.lang:'es-ES'; u.rate=1.02;
  speechSynthesis.speak(u);
  log('TTS reproduciendo respuesta…','info');
}
function addSpeakButton(container,text){
  const b=el('button','btn sm ghost speakbtn'); b.textContent='🔊 Leer en voz alta';
  b.onclick=()=>speak(text); container.parentElement.appendChild(b);
}

/* ===================== STT (dictado por micrófono) ===================== */
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let recog=null, recording=false;
$('#micBtn').onclick=()=>{
  if(!SR){toast('Dictado no soportado en este navegador (prueba Chrome/Edge)');log('SpeechRecognition no disponible.','warn');return;}
  if(recording){recog.stop();return;}
  recog=new SR(); recog.lang='es-ES'; recog.interimResults=true; recog.continuous=false;
  let base=prompt.value;
  recog.onstart=()=>{recording=true;$('#micBtn').classList.add('rec');log('🎙 Escuchando por micrófono…','gpu');};
  recog.onresult=e=>{let t='';for(const r of e.results)t+=r[0].transcript;prompt.value=(base?base+' ':'')+t;autoGrow();};
  recog.onerror=e=>{log('Error STT: '+e.error,'err');};
  recog.onend=()=>{recording=false;$('#micBtn').classList.remove('rec');log('Dictado finalizado.','info');};
  recog.start();
};

/* ===================== NÚCLEO VISIÓN ===================== */
const imgCanvas=$('#imgCanvas'), ictx=imgCanvas.getContext('2d',{willReadFrequently:true});
const drop=$('#drop'), imgInput=$('#imgInput');
drop.onclick=()=>imgInput.click();
['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('drag');}));
['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('drag');}));
drop.addEventListener('drop',e=>{const f=e.dataTransfer.files[0];if(f)loadImage(f);});
imgInput.onchange=e=>{const f=e.target.files[0];if(f)loadImage(f);};

function loadImage(file){
  const img=new Image();
  img.onload=()=>{
    const max=420, sc=Math.min(max/img.width,max/img.height,1);
    imgCanvas.width=img.width*sc; imgCanvas.height=img.height*sc;
    ictx.drawImage(img,0,0,imgCanvas.width,imgCanvas.height);
    state.lastImage=imgCanvas.toDataURL('image/png');
    imgCanvas.style.display='block'; $('#filters').style.display='flex'; $('#visionBtn').style.display='block';
    $('#visionRes').innerHTML='';
    log(`Imagen cargada en Canvas · ${imgCanvas.width}×${imgCanvas.height}px`,'ok');
  };
  img.src=URL.createObjectURL(file);
}

$('#filters').querySelectorAll('button').forEach(b=>b.onclick=()=>applyFilter(b.dataset.f));
function applyFilter(f){
  if(!state.lastImage)return;
  const base=new Image();
  base.onload=()=>{
    ictx.drawImage(base,0,0,imgCanvas.width,imgCanvas.height);
    if(f==='none'){log('Filtro: original','info');return;}
    const d=ictx.getImageData(0,0,imgCanvas.width,imgCanvas.height), p=d.data;
    if(f==='gray'||f==='thermal'){
      for(let i=0;i<p.length;i+=4){
        const g=0.299*p[i]+0.587*p[i+1]+0.114*p[i+2];
        if(f==='gray'){p[i]=p[i+1]=p[i+2]=g;}
        else{p[i]=Math.min(255,g*1.6);p[i+1]=Math.abs(g-128);p[i+2]=Math.max(0,255-g*1.4);}
      }
    } else if(f==='invert'){
      for(let i=0;i<p.length;i+=4){p[i]=255-p[i];p[i+1]=255-p[i+1];p[i+2]=255-p[i+2];}
    } else if(f==='edge'){
      const w=imgCanvas.width,h=imgCanvas.height,src=new Uint8ClampedArray(p),out=d.data;
      const gray=i=>0.299*src[i]+0.587*src[i+1]+0.114*src[i+2];
      for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){
        const i=(y*w+x)*4;
        const gx=gray(i-4)-gray(i+4), gy=gray(i-w*4)-gray(i+w*4);
        const m=Math.min(255,Math.hypot(gx,gy));
        out[i]=out[i+1]=out[i+2]=m;
      }
    }
    ictx.putImageData(d,0,0);
    log('Filtro aplicado: '+f,'gpu');
  };
  base.src=state.lastImage;
}

$('#visionBtn').onclick=async()=>{
  if(!state.lastImage){toast('Sube una imagen primero');return;}
  const res=$('#visionRes'); res.innerHTML='<div class="mini">Inicializando pipeline de visión…</div>';
  $('#visionBtn').disabled=true;
  try{
    if(!state.transformers){
      log('Importando Transformers.js desde CDN…','gpu');
      state.transformers=await import('https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.0.2');
      state.transformers.env.allowLocalModels=false;
    }
    if(!state.visionPipe){
      const device = ('gpu' in navigator)?'webgpu':'wasm';
      log(`Cargando modelo ViT (image-classification · ${device})…`,'gpu');
      res.innerHTML='<div class="mini">Descargando modelo ViT (una sola vez)…</div>';
      state.visionPipe=await state.transformers.pipeline('image-classification','Xenova/vit-base-patch16-224',{device});
      log('Modelo de visión listo.','ok');
    }
    res.innerHTML='<div class="mini">Analizando…</div>';
    const out=await state.visionPipe(state.lastImage,{topk:5});
    res.innerHTML='';
    out.forEach(o=>{
      const t=el('div','tag');
      t.innerHTML=`<span>${esc(o.label)}</span><b>${(o.score*100).toFixed(1)}%</b>`;
      res.appendChild(t);
    });
    log('Visión · '+out.map(o=>`${o.label}(${(o.score*100).toFixed(0)}%)`).join(', '),'ok');
    // alimenta el contexto para que el LLM pueda razonar sobre ello
    state.messages.push({role:'system',content:'Resultado de clasificación de imagen local: '+out.map(o=>`${o.label} ${(o.score*100).toFixed(1)}%`).join(', ')});
  }catch(e){
    res.innerHTML=`<div class="mini" style="color:var(--red)">Error: ${esc(e.message)}</div>`;
    log('Error núcleo visión: '+e.message,'err');
  }finally{$('#visionBtn').disabled=false;}
};

/* ===================== NÚCLEO MUSICAL (Web Audio) ===================== */
const NOTE_IDX={C:0,'C#':1,D:2,'D#':3,E:4,F:5,'F#':6,G:7,'G#':8,A:9,'A#':10,B:11};
const SCALES={major:[0,2,4,5,7,9,11],minor:[0,2,3,5,7,8,10],dorian:[0,2,3,5,7,9,10],pentatonic:[0,3,5,7,10],blues:[0,3,5,6,7,10]};
function noteToFreq(name){
  const m=name.match(/^([A-G]#?)(\d)$/); if(!m)return 440;
  const semis=NOTE_IDX[m[1]]+(parseInt(m[2])-4)*12 - 9; // A4=440 ref
  return 440*Math.pow(2,semis/12);
}
function ac(){ if(!state.audioCtx) state.audioCtx=new (window.AudioContext||window.webkitAudioContext)(); return state.audioCtx; }

function playNote(freq,start,dur,type='triangle',gain=0.18){
  const c=ac(), o=c.createOscillator(), g=c.createGain();
  o.type=type; o.frequency.value=freq;
  const t=c.currentTime+start;
  g.gain.setValueAtTime(0,t);
  g.gain.linearRampToValueAtTime(gain,t+0.015);
  g.gain.exponentialRampToValueAtTime(0.0001,t+dur*0.95);
  o.connect(g).connect(c.destination);
  o.start(t); o.stop(t+dur);
}
function playDrum(start,kind){
  const c=ac();
  if(kind==='kick'){
    const o=c.createOscillator(),g=c.createGain(),t=c.currentTime+start;
    o.frequency.setValueAtTime(150,t);o.frequency.exponentialRampToValueAtTime(45,t+0.12);
    g.gain.setValueAtTime(0.5,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.18);
    o.connect(g).connect(c.destination);o.start(t);o.stop(t+0.2);
  } else { // hat: ruido
    const n=c.createBufferSource(),buf=c.createBuffer(1,2048,c.sampleRate);
    const dd=buf.getChannelData(0);for(let i=0;i<2048;i++)dd[i]=Math.random()*2-1;
    n.buffer=buf;const hp=c.createBiquadFilter();hp.type='highpass';hp.frequency.value=7000;
    const g=c.createGain(),t=c.currentTime+start;g.gain.setValueAtTime(0.14,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.05);
    n.connect(hp).connect(g).connect(c.destination);n.start(t);n.stop(t+0.06);
  }
}

function generateSequence(){
  const key=$('#mKey').value, scaleName=$('#mScale').value, bpm=parseInt($('#mBpm').value);
  const root=NOTE_IDX[key], scale=SCALES[scaleName];
  const seq=[], steps=16;
  for(let i=0;i<steps;i++){
    const deg=scale[Math.floor(Math.random()*scale.length)];
    const oct=4+(Math.random()<0.3?1:0);
    const semi=root+deg; const nn=Object.keys(NOTE_IDX)[((semi%12)+12)%12]+oct;
    seq.push({note:nn,start:i*0.5,dur:0.45});
  }
  return {bpm,notes:seq};
}

let drawSteps=[];
function renderSeqUI(active){
  const c=$('#mSeq');
  if(!drawSteps.length){c.innerHTML='';for(let i=0;i<16;i++){const s=el('div','step'+(i%4===0?' beat':''));c.appendChild(s);drawSteps.push(s);}}
  drawSteps.forEach((s,i)=>s.classList.toggle('on',i===active));
}

function playSequence(seqObj){
  state.musicStop=false;
  const c=ac(); if(c.state==='suspended')c.resume();
  const bpm=seqObj.bpm||parseInt($('#mBpm').value), beat=60/bpm;
  renderSeqUI(-1);
  const total=Math.max(...seqObj.notes.map(n=>n.start+n.dur),8);
  seqObj.notes.forEach(n=>{
    const f=noteToFreq(n.note);
    playNote(f,n.start*beat,n.dur*beat,'sawtooth',0.14);     // melodía
    playNote(f/2,n.start*beat,n.dur*beat,'triangle',0.09);   // bajo
  });
  // percusión en rejilla de 16
  for(let i=0;i<16;i++){const t=i*0.5*beat; playDrum(t,i%4===0?'kick':'hat');}
  // animación de secuenciador
  let step=0;
  const iv=setInterval(()=>{ if(state.musicStop||step>15){clearInterval(iv);renderSeqUI(-1);return;} renderSeqUI(step);step++; },0.5*beat*1000);
  log(`♪ Reproduciendo secuencia · ${seqObj.notes.length} notas · ${bpm} BPM`,'gpu');
}

$('#mPlay').onclick=()=>{ const s=generateSequence(); playSequence(s);
  log(`Secuencia generada en ${$('#mKey').value} ${$('#mScale').value}`,'info'); };
$('#mStop').onclick=()=>{ state.musicStop=true; if(state.audioCtx){state.audioCtx.close();state.audioCtx=null;} renderSeqUI(-1); log('Audio detenido.','warn'); };
renderSeqUI(-1);

// Si el LLM (modo música) devuelve JSON de secuencia, lo tocamos
function tryPlayFromText(text){
  const m=text.match(/```json\s*([\s\S]*?)```/i)||text.match(/(\{[\s\S]*"notes"[\s\S]*\})/);
  if(!m)return;
  try{ const obj=JSON.parse(m[1].trim()); if(obj&&Array.isArray(obj.notes)&&obj.notes.length){ playSequence(obj); toast('🎵 Reproduciendo composición del núcleo'); } }
  catch(e){ log('No se pudo parsear la secuencia musical generada.','warn'); }
}

/* ===================== HISTORIAL (IndexedDB) ===================== */
let db=null;
function openDB(){
  return new Promise((res,rej)=>{
    const r=indexedDB.open('nexus-db',1);
    r.onupgradeneeded=e=>{const d=e.target.result; if(!d.objectStoreNames.contains('sessions'))d.createObjectStore('sessions',{keyPath:'id'});};
    r.onsuccess=e=>{db=e.target.result;res(db);};
    r.onerror=e=>rej(e);
  });
}
function idbPut(obj){return new Promise(r=>{const tx=db.transaction('sessions','readwrite');tx.objectStore('sessions').put(obj);tx.oncomplete=r;});}
function idbAll(){return new Promise(r=>{const tx=db.transaction('sessions','readonly');const rq=tx.objectStore('sessions').getAll();rq.onsuccess=()=>r(rq.result||[]);});}
function idbDel(id){return new Promise(r=>{const tx=db.transaction('sessions','readwrite');tx.objectStore('sessions').delete(id);tx.oncomplete=r;});}
function idbClear(){return new Promise(r=>{const tx=db.transaction('sessions','readwrite');tx.objectStore('sessions').clear();tx.oncomplete=r;});}

async function saveSession(){
  if(!db||!state.messages.length)return;
  if(!state.sessionId)state.sessionId='s'+Date.now();
  const first=state.messages.find(m=>m.role==='user');
  const title=(first?first.content:'Sesión').slice(0,42);
  await idbPut({id:state.sessionId,title,mode:currentMode,messages:state.messages,ts:Date.now()});
  localStorage.setItem('nexus-last',state.sessionId);
  renderSessions();
}
async function renderSessions(){
  const list=(await idbAll()).sort((a,b)=>b.ts-a.ts);
  const c=$('#sessions'); c.innerHTML='';
  if(!list.length){c.innerHTML='<div class="mini">Sin sesiones guardadas.</div>';return;}
  list.forEach(s=>{
    const row=el('div','sess');
    const sp=el('span'); sp.textContent=`${MODES[s.mode]?.icon||'✦'} ${s.title}`; sp.title=s.title;
    sp.onclick=()=>loadSession(s);
    const del=el('button','btn sm danger'); del.textContent='✕';
    del.onclick=async(e)=>{e.stopPropagation();await idbDel(s.id);if(state.sessionId===s.id){state.sessionId=null;}renderSessions();log('Sesión eliminada.','warn');};
    row.appendChild(sp); row.appendChild(del); c.appendChild(row);
  });
}
function loadSession(s){
  state.messages=s.messages.slice(); state.sessionId=s.id; setMode(s.mode||'general');
  chatEl.innerHTML='';
  state.messages.forEach(m=>{
    if(m.role==='system')return;
    const cont=addMessage(m.role);
    if(m.role==='assistant'){renderMarkdown(cont,m.content,false);addSpeakButton(cont,m.content);}
    else cont.textContent=m.content;
  });
  log('Sesión restaurada: '+s.title,'ok');
  $('#side').classList.remove('open');$('#scrim').classList.remove('on');
}
$('#newChat').onclick=async()=>{ await saveSession(); state.messages=[]; state.sessionId=null; chatEl.innerHTML=''; location.hash=''; log('Nueva conversación iniciada.','info');
  const w=el('div','welcome'); w.id='welcome'; w.innerHTML='<div class="big">NEXUS</div><p class="mini">Listo para una nueva sesión. Escribe o dicta tu primer comando.</p>'; chatEl.appendChild(w); };
$('#clearHist').onclick=async()=>{ if(confirm('¿Borrar todo el historial local?')){await idbClear();state.sessionId=null;renderSessions();log('Historial completo eliminado.','warn');toast('Historial borrado');} };

