<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>NEXUS // Núcleo IA Local</title>
<meta name="description" content="IA local y autónoma en el navegador: WebGPU + WebLLM + Transformers.js. Sin APIs externas." />

<!-- Fuentes -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Orbitron:wght@500;700;900&display=swap" rel="stylesheet" />

<!-- Markdown + resaltado + saneado (scripts clásicos, globales) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.6/purify.min.js"></script>

<style>
  :root{
    --bg:#070a0f; --bg2:#0a0e16; --panel:#0c1320; --panel2:#0e1726;
    --line:#17243a; --line2:#1f3350;
    --txt:#c7d4e6; --muted:#6c7f9c; --dim:#44546e;
    --cyan:#00e5ff; --cyan-d:#0097a7; --mag:#ff2bd6; --grn:#39ff14; --amber:#ffb300; --red:#ff4d5e;
    --glow:0 0 0 1px rgba(0,229,255,.25), 0 0 22px rgba(0,229,255,.12);
    --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    --disp:'Orbitron',var(--mono);
    --r:12px;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0; background:
      radial-gradient(1200px 600px at 85% -10%, rgba(255,43,214,.06), transparent 60%),
      radial-gradient(1200px 700px at -10% 110%, rgba(0,229,255,.07), transparent 55%),
      var(--bg);
    color:var(--txt); font-family:var(--mono); font-size:14px; line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  ::-webkit-scrollbar{width:10px;height:10px}
  ::-webkit-scrollbar-thumb{background:#14263d;border-radius:20px;border:2px solid transparent;background-clip:padding-box}
  ::-webkit-scrollbar-thumb:hover{background:#1d3b5e}
  button{font-family:var(--mono);cursor:pointer}
  a{color:var(--cyan)}
  input,select,textarea{font-family:var(--mono)}

  /* ====== Layout ====== */
  .app{display:grid;grid-template-rows:auto 1fr auto;height:100vh;height:100dvh}

  /* Header / status bar */
  header{
    border-bottom:1px solid var(--line);
    background:linear-gradient(180deg,var(--panel2),var(--panel));
    padding:10px 14px; display:flex;gap:14px;align-items:center;flex-wrap:wrap;
  }
  .brand{display:flex;align-items:center;gap:10px;min-width:180px}
  .logo{width:30px;height:30px;border-radius:8px;position:relative;
    background:conic-gradient(from 210deg,var(--cyan),var(--mag),var(--cyan));
    box-shadow:var(--glow);filter:saturate(1.2)}
  .logo:after{content:"";position:absolute;inset:3px;border-radius:6px;background:var(--bg2)}
  .logo b{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--disp);
    font-weight:900;color:var(--cyan);font-size:13px;z-index:2;text-shadow:0 0 8px rgba(0,229,255,.6)}
  .title{display:flex;flex-direction:column;line-height:1.05}
  .title h1{font-family:var(--disp);font-size:16px;letter-spacing:2px;margin:0;color:#eaf6ff}
  .title small{color:var(--muted);font-size:10px;letter-spacing:1px}

  .status{display:flex;gap:10px;align-items:center;flex-wrap:wrap;flex:1;min-width:260px}
  .chip{display:inline-flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--line);
    padding:5px 10px;border-radius:999px;font-size:11px;color:var(--muted);white-space:nowrap}
  .chip b{color:var(--txt);font-weight:500}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--dim);box-shadow:0 0 0 0 transparent;transition:.3s}
  .dot.ok{background:var(--grn);box-shadow:0 0 10px var(--grn)}
  .dot.warn{background:var(--amber);box-shadow:0 0 10px var(--amber)}
  .dot.err{background:var(--red);box-shadow:0 0 10px var(--red)}
  .dot.live{background:var(--cyan);animation:pulse 1s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(0,229,255,.6)}70%{box-shadow:0 0 0 7px rgba(0,229,255,0)}100%{box-shadow:0 0 0 0 rgba(0,229,255,0)}}

  .loadbar{flex:1 1 220px;min-width:180px;display:flex;flex-direction:column;gap:4px}
  .loadbar .meta{display:flex;justify-content:space-between;font-size:10px;color:var(--muted)}
  .track{height:8px;background:#0a1322;border:1px solid var(--line);border-radius:999px;overflow:hidden;position:relative}
  .fill{height:100%;width:0%;background:linear-gradient(90deg,var(--cyan),var(--mag));
    box-shadow:0 0 12px rgba(0,229,255,.5);transition:width .25s;border-radius:999px}
  .fill.indet{width:35% !important;animation:indet 1.1s infinite ease-in-out}
  @keyframes indet{0%{margin-left:-40%}100%{margin-left:105%}}

  .hdr-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  select,.btn,input[type=text],input[type=number]{
    background:var(--panel);color:var(--txt);border:1px solid var(--line2);border-radius:9px;padding:8px 10px;font-size:12px;outline:none}
  select:focus,input:focus{border-color:var(--cyan-d);box-shadow:0 0 0 2px rgba(0,229,255,.12)}
  .btn{display:inline-flex;align-items:center;gap:7px;transition:.15s;white-space:nowrap}
  .btn:hover{border-color:var(--cyan);color:#eaf6ff}
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .btn.primary{background:linear-gradient(180deg,#07323b,#06222a);border-color:var(--cyan-d);color:#d9fbff}
  .btn.primary:hover{box-shadow:var(--glow)}
  .btn.ghost{background:transparent}
  .btn.danger:hover{border-color:var(--red);color:#ffd7db}
  .btn.sm{padding:5px 8px;font-size:11px}

  /* Main */
  main{display:grid;grid-template-columns:300px 1fr;min-height:0;overflow:hidden}
  @media(max-width:1080px){main{grid-template-columns:1fr}
    aside.side{position:fixed;z-index:40;left:0;top:0;bottom:0;width:320px;transform:translateX(-105%);
      transition:transform .25s;box-shadow:30px 0 60px rgba(0,0,0,.6)}
    aside.side.open{transform:none}
    .scrim{display:none;position:fixed;inset:0;background:rgba(2,5,10,.6);z-index:35}
    .scrim.on{display:block}
  }
  @media(min-width:1081px){#menuBtn,.scrim{display:none}}

  aside.side{border-right:1px solid var(--line);background:var(--bg2);overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:14px}
  .block{background:linear-gradient(180deg,var(--panel),var(--bg2));border:1px solid var(--line);border-radius:var(--r);padding:12px}
  .block h3{margin:0 0 10px;font-family:var(--disp);font-size:11px;letter-spacing:2px;color:var(--cyan);text-transform:uppercase;display:flex;align-items:center;gap:8px}
  .block h3:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}

  .modes{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .mode{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:9px;text-align:left;color:var(--muted);transition:.15s;display:flex;flex-direction:column;gap:3px}
  .mode .ic{font-size:16px}
  .mode .nm{font-size:11px;color:var(--txt);font-weight:500}
  .mode .ds{font-size:9px;color:var(--dim);line-height:1.25}
  .mode:hover{border-color:var(--line2)}
  .mode.active{border-color:var(--cyan);color:var(--txt);background:linear-gradient(180deg,#07262e,#081420);box-shadow:inset 0 0 0 1px rgba(0,229,255,.25)}
  .mode.active .nm{color:var(--cyan)}

  .row{display:flex;gap:8px;align-items:center;margin:8px 0}
  .row label{font-size:11px;color:var(--muted);min-width:66px}
  .row input[type=range]{flex:1;accent-color:var(--cyan)}
  .row .val{font-size:11px;color:var(--cyan);min-width:34px;text-align:right}
  .full{width:100%}

  .drop{border:1px dashed var(--line2);border-radius:10px;padding:14px;text-align:center;color:var(--muted);font-size:11px;transition:.15s;cursor:pointer}
  .drop:hover,.drop.drag{border-color:var(--cyan);color:var(--txt);background:rgba(0,229,255,.04)}
  #imgCanvas{width:100%;border-radius:10px;border:1px solid var(--line);margin-top:10px;display:none;background:#05080d}
  .filters{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
  .vres{margin-top:8px;font-size:11px}
  .vres .tag{display:inline-flex;justify-content:space-between;gap:10px;background:var(--panel2);border:1px solid var(--line);border-radius:7px;padding:4px 8px;margin:3px 0;width:100%}
  .vres .tag b{color:var(--cyan)}

  .sessions{display:flex;flex-direction:column;gap:6px;max-height:160px;overflow:auto}
  .sess{display:flex;justify-content:space-between;gap:8px;align-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:7px 9px;font-size:11px}
  .sess span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer;flex:1}
  .sess span:hover{color:var(--cyan)}

  /* Center column */
  .center{display:grid;grid-template-rows:1fr auto;min-height:0;position:relative}
  #chat{overflow-y:auto;padding:20px clamp(12px,4vw,42px);display:flex;flex-direction:column;gap:18px;scroll-behavior:smooth}
  .welcome{max-width:720px;margin:6vh auto;text-align:center;color:var(--muted)}
  .welcome .big{font-family:var(--disp);font-size:clamp(24px,5vw,40px);letter-spacing:3px;color:#eaf6ff;margin:0 0 6px;
    background:linear-gradient(90deg,var(--cyan),var(--mag));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .welcome p{font-size:13px}
  .pills{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:16px}
  .pill{background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:7px 12px;font-size:11px;color:var(--muted);cursor:pointer}
  .pill:hover{border-color:var(--cyan);color:var(--txt)}

  .msg{display:flex;gap:12px;max-width:900px;width:100%;margin:0 auto;animation:rise .25s ease}
  @keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .msg .av{width:30px;height:30px;border-radius:8px;flex-shrink:0;display:grid;place-items:center;font-size:13px;font-weight:700;border:1px solid var(--line2)}
  .msg.user .av{background:#10233a;color:var(--cyan)}
  .msg.ai .av{background:conic-gradient(from 200deg,#07323b,#2a0b26);color:var(--mag);box-shadow:0 0 14px rgba(255,43,214,.25)}
  .msg.sys .av{background:#1a1407;color:var(--amber)}
  .bubble{flex:1;min-width:0}
  .who{font-size:10px;letter-spacing:1px;color:var(--muted);margin-bottom:4px;text-transform:uppercase;display:flex;gap:8px;align-items:center}
  .who .modebadge{color:var(--cyan)}
  .content{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;overflow:hidden}
  .msg.user .content{background:#0b1726;border-color:var(--line2)}
  .content p{margin:.4em 0}
  .content h1,.content h2,.content h3{color:#eaf6ff;margin:.6em 0 .3em}
  .content ul,.content ol{margin:.3em 0 .3em 1.1em}
  .content code:not(pre code){background:#0a1626;border:1px solid var(--line);border-radius:5px;padding:1px 5px;color:var(--cyan);font-size:12.5px}
  .content pre{position:relative;background:#05090f !important;border:1px solid var(--line2);border-radius:10px;padding:14px 12px;overflow:auto;margin:.6em 0}
  .content pre code{background:transparent !important;padding:0;font-size:12.5px}
  .codebar{position:absolute;top:6px;right:6px;display:flex;gap:6px}
  .copybtn{background:#0b1a2b;border:1px solid var(--line2);color:var(--muted);border-radius:6px;padding:3px 8px;font-size:10px}
  .copybtn:hover{color:var(--cyan);border-color:var(--cyan)}
  .cursor{display:inline-block;width:8px;height:15px;background:var(--cyan);margin-left:2px;animation:blink .9s step-end infinite;vertical-align:text-bottom}
  @keyframes blink{50%{opacity:0}}
  .speakbtn{margin-top:8px}

  /* Composer */
  .composer{border-top:1px solid var(--line);background:linear-gradient(0deg,var(--panel),var(--bg2));padding:12px clamp(12px,4vw,42px)}
  .composer .inner{max-width:900px;margin:0 auto;display:flex;gap:10px;align-items:flex-end;background:var(--panel);border:1px solid var(--line2);border-radius:14px;padding:8px 8px 8px 14px}
  .composer .inner:focus-within{border-color:var(--cyan-d);box-shadow:0 0 0 2px rgba(0,229,255,.1)}
  #prompt{flex:1;background:transparent;border:0;outline:none;color:var(--txt);resize:none;max-height:180px;min-height:24px;font-size:14px;padding:6px 0;line-height:1.45}
  .iconbtn{width:38px;height:38px;border-radius:10px;background:var(--panel2);border:1px solid var(--line2);color:var(--muted);display:grid;place-items:center;font-size:16px;flex-shrink:0;transition:.15s}
  .iconbtn:hover{color:var(--cyan);border-color:var(--cyan)}
  .iconbtn.rec{color:var(--red);border-color:var(--red);animation:pulse 1s infinite}
  .iconbtn.send{background:linear-gradient(180deg,#07323b,#06222a);color:var(--cyan);border-color:var(--cyan-d)}
  .hint{max-width:900px;margin:6px auto 0;font-size:10px;color:var(--dim);display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}

  /* Log console (drawer) */
  footer{border-top:1px solid var(--line);background:var(--bg2)}
  .loghead{display:flex;align-items:center;gap:12px;padding:7px 14px;cursor:pointer;user-select:none}
  .loghead .t{font-family:var(--disp);font-size:11px;letter-spacing:2px;color:var(--grn);display:flex;align-items:center;gap:8px}
  .loghead .t:before{content:"▓";color:var(--grn);text-shadow:0 0 8px var(--grn)}
  .logmeta{display:flex;gap:10px;flex:1;flex-wrap:wrap;justify-content:flex-end}
  #logbody{height:0;overflow:auto;transition:height .2s;background:#05080d;font-size:11.5px;padding:0 14px}
  #logbody.open{height:190px;padding:10px 14px;border-top:1px solid var(--line)}
  .logline{display:flex;gap:10px;padding:1px 0;white-space:pre-wrap;word-break:break-word}
  .logline .ts{color:var(--dim);flex-shrink:0}
  .logline.info .m{color:#9fd0ff}
  .logline.ok .m{color:var(--grn)}
  .logline.warn .m{color:var(--amber)}
  .logline.err .m{color:var(--red)}
  .logline.gpu .m{color:var(--mag)}

  .toast{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--panel2);border:1px solid var(--cyan-d);
    color:#d9fbff;padding:9px 16px;border-radius:10px;font-size:12px;box-shadow:var(--glow);z-index:80;opacity:0;pointer-events:none;transition:.25s}
  .toast.on{opacity:1;transform:translateX(-50%) translateY(-4px)}
  .mini{font-size:10px;color:var(--dim)}
  .seq{display:flex;gap:3px;flex-wrap:wrap;margin-top:8px}
  .step{width:16px;height:22px;border-radius:4px;background:var(--panel2);border:1px solid var(--line)}
  .step.on{background:var(--cyan);box-shadow:0 0 8px var(--cyan)}
  .step.beat{border-color:var(--mag)}
</style>
</head>
<body>
<div class="app">

  <!-- ===================== HEADER / STATUS ===================== -->
  <header>
    <button id="menuBtn" class="iconbtn" title="Menú" style="width:34px;height:34px">☰</button>
    <div class="brand">
      <div class="logo"><b>N</b></div>
      <div class="title"><h1>NEXUS</h1><small>NÚCLEO IA LOCAL · WEBGPU</small></div>
    </div>

    <div class="status">
      <span class="chip"><span id="gpuDot" class="dot"></span>GPU: <b id="gpuName">detectando…</b></span>
      <span class="chip"><span id="engDot" class="dot"></span>Motor: <b id="engState">inactivo</b></span>
      <span class="chip">RAM JS: <b id="ramVal">—</b></span>
      <div class="loadbar">
        <div class="meta"><span id="loadText">Modelo no cargado</span><span id="loadPct">0%</span></div>
        <div class="track"><div id="loadFill" class="fill"></div></div>
      </div>
    </div>

    <div class="hdr-controls">
      <select id="modelSel" title="Modelo local"></select>
      <button id="loadBtn" class="btn primary">⚡ Cargar</button>
    </div>
  </header>

  <!-- ===================== MAIN ===================== -->
  <main>
    <div class="scrim" id="scrim"></div>
    <aside class="side" id="side">

      <!-- Modos -->
      <div class="block">
        <h3>Modos de operación</h3>
        <div class="modes" id="modes"></div>
      </div>

      <!-- Parámetros -->
      <div class="block">
        <h3>Parámetros del núcleo</h3>
        <div class="row"><label>Temperatura</label><input id="temp" type="range" min="0" max="1.5" step="0.05" value="0.6"><span class="val" id="tempV">0.60</span></div>
        <div class="row"><label>Top-P</label><input id="topp" type="range" min="0.1" max="1" step="0.05" value="0.95"><span class="val" id="toppV">0.95</span></div>
        <div class="row"><label>Máx. tokens</label><input id="maxtok" type="range" min="128" max="4096" step="128" value="1024"><span class="val" id="maxtokV">1024</span></div>
        <div class="row" style="margin-top:4px"><label style="min-width:auto">Auto-TTS</label><input id="autotts" type="checkbox"><span class="mini" style="margin-left:auto">leer respuestas en voz</span></div>
      </div>

      <!-- Visión -->
      <div class="block">
        <h3>Núcleo visión</h3>
        <div class="drop" id="drop">Arrastra o pulsa para subir imagen<input id="imgInput" type="file" accept="image/*" hidden></div>
        <canvas id="imgCanvas"></canvas>
        <div class="filters" id="filters" style="display:none">
          <button class="btn sm" data-f="none">Original</button>
          <button class="btn sm" data-f="gray">B/N</button>
          <button class="btn sm" data-f="invert">Invertir</button>
          <button class="btn sm" data-f="edge">Bordes</button>
          <button class="btn sm" data-f="thermal">Térmico</button>
        </div>
        <button class="btn sm full" id="visionBtn" style="display:none;margin-top:8px">🔍 Analizar (ViT · WebGPU)</button>
        <div class="vres" id="visionRes"></div>
      </div>

      <!-- Música -->
      <div class="block">
        <h3>Núcleo musical</h3>
        <div class="row"><label>Tonalidad</label>
          <select id="mKey" class="full">
            <option>C</option><option>C#</option><option>D</option><option>D#</option><option>E</option><option>F</option>
            <option>F#</option><option>G</option><option>G#</option><option>A</option><option>A#</option><option>B</option>
          </select></div>
        <div class="row"><label>Escala</label>
          <select id="mScale" class="full">
            <option value="major">Mayor</option><option value="minor">Menor</option>
            <option value="dorian">Dórica</option><option value="pentatonic">Pentatónica</option>
            <option value="blues">Blues</option>
          </select></div>
        <div class="row"><label>BPM</label><input id="mBpm" type="range" min="60" max="180" step="2" value="110"><span class="val" id="mBpmV">110</span></div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">
          <button class="btn sm" id="mPlay">▶ Generar + tocar</button>
          <button class="btn sm danger" id="mStop">■ Parar</button>
        </div>
        <div class="seq" id="mSeq"></div>
        <div class="mini" style="margin-top:6px">Síntesis real vía Web Audio API · patrón procedimental</div>
      </div>

      <!-- Historial -->
      <div class="block">
        <h3>Historial (IndexedDB)</h3>
        <div style="display:flex;gap:6px;margin-bottom:8px">
          <button class="btn sm" id="newChat">＋ Nuevo</button>
          <button class="btn sm danger" id="clearHist">🗑 Limpiar</button>
        </div>
        <div class="sessions" id="sessions"></div>
      </div>

    </aside>

    <!-- Centro -->
    <section class="center">
      <div id="chat">
        <div class="welcome" id="welcome">
          <div class="big">NEXUS</div>
          <p>Inteligencia artificial <b>100% local y autónoma</b> ejecutándose en tu navegador.<br>
          Sin APIs externas, sin claves. Inferencia en WebGPU vía WebLLM + Transformers.js.</p>
          <p class="mini">1 · Elige un modelo arriba y pulsa <b>⚡ Cargar</b> · 2 · Selecciona un modo · 3 · Habla o escribe.</p>
          <div class="pills" id="pills">
            <span class="pill" data-q="Audita este script y detecta vectores de inyección:">🛡 Auditar script</span>
            <span class="pill" data-q="Genera un shader GLSL de agua animada para WebGL.">🎮 Shader GLSL</span>
            <span class="pill" data-q="Explícame cómo optimizar un bucle de render en Canvas 2D.">⚙ Optimizar render</span>
            <span class="pill" data-q="Propón una progresión de acordes épica en tono menor.">🎵 Progresión</span>
          </div>
        </div>
      </div>

      <div class="composer">
        <div class="inner">
          <textarea id="prompt" placeholder="Escribe un comando o pulsa 🎙 para dictar…" rows="1"></textarea>
          <button class="iconbtn" id="micBtn" title="Dictar (Web Speech API)">🎙</button>
