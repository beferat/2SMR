<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="AI Multimedia Research & Production Studio — suite web multimodal 100% client-side.">
<title>AI Multimedia Studio</title>
<style>
/* ============================================================
   AI MULTIMEDIA STUDIO — Dark Studio Theme
   ============================================================ */
:root{
  --bg-0:#0b0c10;
  --bg-1:#111218;
  --bg-2:#171922;
  --bg-3:#1e2130;
  --bg-elev:#232637;
  --line:#2a2e42;
  --line-soft:#21243400;
  --txt-0:#f2f4fb;
  --txt-1:#c3c8da;
  --txt-2:#8b91a9;
  --txt-3:#5c617a;
  --accent:#7c5cff;
  --accent-2:#22d3ee;
  --accent-grad:linear-gradient(135deg,#7c5cff 0%,#22d3ee 100%);
  --ok:#2ec28a;
  --warn:#f5a623;
  --err:#ff5d6c;
  --radius:14px;
  --radius-sm:9px;
  --shadow:0 12px 40px rgba(0,0,0,.45);
  --mono:ui-monospace,"JetBrains Mono","SF Mono",Menlo,Consolas,monospace;
  --sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;font-family:var(--sans);background:var(--bg-0);color:var(--txt-0);
  font-size:14px;line-height:1.5;overflow:hidden;-webkit-font-smoothing:antialiased;
}
button{font-family:inherit;cursor:pointer}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#2d3147;border-radius:20px;border:2px solid var(--bg-1)}
::-webkit-scrollbar-thumb:hover{background:#3a3f5c}
input,textarea,select{font-family:inherit}

/* ---------- Layout ---------- */
#app{display:flex;height:100vh;width:100vw}
#sidebar{
  width:256px;flex-shrink:0;background:var(--bg-1);border-right:1px solid var(--line);
  display:flex;flex-direction:column;transition:width .2s ease;
}
#sidebar.collapsed{width:64px}
.brand{display:flex;align-items:center;gap:10px;padding:16px 16px 14px;border-bottom:1px solid var(--line)}
.brand .logo{width:34px;height:34px;border-radius:9px;background:var(--accent-grad);display:grid;place-items:center;flex-shrink:0;font-weight:800;color:#fff;font-size:17px;box-shadow:0 4px 14px rgba(124,92,255,.4)}
.brand .title{font-weight:700;font-size:15px;letter-spacing:.2px;white-space:nowrap;overflow:hidden}
.brand .title small{display:block;font-weight:500;font-size:10.5px;color:var(--txt-2);letter-spacing:1px;text-transform:uppercase}
#sidebar.collapsed .title,#sidebar.collapsed .nav-label,#sidebar.collapsed .nav-group-title{display:none}

#nav{flex:1;overflow-y:auto;padding:10px 10px 20px}
.nav-group-title{font-size:10.5px;text-transform:uppercase;letter-spacing:1.2px;color:var(--txt-3);margin:16px 8px 6px;font-weight:700}
.nav-item{
  display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:var(--radius-sm);
  color:var(--txt-1);margin-bottom:2px;font-size:13.5px;font-weight:500;user-select:none;
  transition:background .12s,color .12s;position:relative;
}
.nav-item:hover{background:var(--bg-2);color:var(--txt-0)}
.nav-item.active{background:var(--bg-3);color:#fff}
.nav-item.active::before{content:"";position:absolute;left:-10px;top:8px;bottom:8px;width:3px;border-radius:3px;background:var(--accent-grad)}
.nav-item .ic{width:20px;height:20px;flex-shrink:0;opacity:.9}
.nav-item.active .ic{opacity:1}
#sidebar.collapsed .nav-item{justify-content:center;padding:10px 0}

.side-footer{padding:10px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:6px}
.side-btn{display:flex;align-items:center;gap:10px;width:100%;padding:9px 11px;border:none;background:var(--bg-2);color:var(--txt-1);border-radius:var(--radius-sm);font-size:13px;font-weight:500;transition:.12s}
.side-btn:hover{background:var(--bg-3);color:#fff}
#sidebar.collapsed .side-btn span{display:none}
#sidebar.collapsed .side-btn{justify-content:center}

/* ---------- Main ---------- */
#main{flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg-0)}
#topbar{
  height:56px;flex-shrink:0;border-bottom:1px solid var(--line);display:flex;align-items:center;
  gap:14px;padding:0 18px;background:var(--bg-1)
}
.hamb{background:var(--bg-2);border:1px solid var(--line);width:34px;height:34px;border-radius:8px;color:var(--txt-1);display:grid;place-items:center}
.hamb:hover{color:#fff}
#modeTitle{font-weight:700;font-size:15.5px}
#modeTitle small{display:block;font-weight:500;font-size:11.5px;color:var(--txt-2)}
.top-spacer{flex:1}
.model-select{display:flex;align-items:center;gap:8px}
.model-select label{font-size:11px;color:var(--txt-2);text-transform:uppercase;letter-spacing:.6px;font-weight:600}
.sel{background:var(--bg-2);border:1px solid var(--line);color:var(--txt-0);padding:7px 10px;border-radius:8px;font-size:12.5px;outline:none;max-width:230px}
.sel:focus{border-color:var(--accent)}
.status-dot{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--txt-2);padding:6px 10px;border:1px solid var(--line);border-radius:20px;background:var(--bg-2)}
.status-dot .d{width:8px;height:8px;border-radius:50%;background:var(--err)}
.status-dot.on .d{background:var(--ok);box-shadow:0 0 8px var(--ok)}

#view{flex:1;overflow:hidden;position:relative}
.panel{position:absolute;inset:0;display:none;flex-direction:column;overflow:hidden}
.panel.active{display:flex}

/* ---------- Chat ---------- */
.chat-scroll{flex:1;overflow-y:auto;padding:26px 0}
.chat-inner{max-width:860px;margin:0 auto;padding:0 24px;display:flex;flex-direction:column;gap:22px}
.msg{display:flex;gap:14px;animation:fade .25s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.msg .av{width:32px;height:32px;border-radius:9px;flex-shrink:0;display:grid;place-items:center;font-size:13px;font-weight:700}
.msg.user .av{background:var(--bg-3);color:var(--txt-1)}
.msg.ai .av{background:var(--accent-grad);color:#fff}
.msg .body{flex:1;min-width:0}
.msg .who{font-size:11.5px;color:var(--txt-2);margin-bottom:4px;font-weight:600;letter-spacing:.3px}
.bubble{background:var(--bg-2);border:1px solid var(--line);border-radius:var(--radius);padding:13px 16px;color:var(--txt-0);overflow-wrap:break-word}
.msg.user .bubble{background:var(--bg-3)}
.attach-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:9px}
.attach-thumb{width:64px;height:64px;border-radius:8px;object-fit:cover;border:1px solid var(--line)}
.attach-chip{display:inline-flex;align-items:center;gap:6px;background:var(--bg-3);border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--txt-1)}

.empty-state{max-width:720px;margin:auto;text-align:center;padding:40px 24px;color:var(--txt-2)}
.empty-state .big{width:62px;height:62px;border-radius:16px;background:var(--bg-2);border:1px solid var(--line);display:grid;place-items:center;margin:0 auto 18px}
.empty-state h2{color:var(--txt-0);font-size:20px;margin:0 0 8px}
.empty-state p{margin:0 auto;max-width:520px}
.suggest{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:22px}
.suggest .s{background:var(--bg-2);border:1px solid var(--line);border-radius:10px;padding:11px 14px;font-size:12.5px;color:var(--txt-1);max-width:240px;text-align:left}
.suggest .s:hover{border-color:var(--accent);color:#fff}

/* ---------- Composer ---------- */
.composer-wrap{flex-shrink:0;padding:14px 24px 18px;border-top:1px solid var(--line);background:linear-gradient(180deg,rgba(11,12,16,0),var(--bg-1))}
.composer{max-width:860px;margin:0 auto;background:var(--bg-2);border:1px solid var(--line);border-radius:16px;padding:10px 12px;transition:border .15s}
.composer.drag{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,92,255,.15)}
.composer-attachments{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
.composer-attachments:empty{display:none}
.ca-item{position:relative;display:inline-flex;align-items:center;gap:7px;background:var(--bg-3);border:1px solid var(--line);border-radius:9px;padding:5px 8px;font-size:11.5px}
.ca-item img{width:30px;height:30px;border-radius:6px;object-fit:cover}
.ca-item .x{cursor:pointer;color:var(--txt-2);font-weight:700;padding:0 2px}
.ca-item .x:hover{color:var(--err)}
.composer-row{display:flex;align-items:flex-end;gap:8px}
#composerInput{flex:1;background:transparent;border:none;outline:none;color:var(--txt-0);font-size:14px;resize:none;max-height:220px;line-height:1.55;padding:6px 4px}
#composerInput::placeholder{color:var(--txt-3)}
.comp-btn{width:36px;height:36px;border-radius:9px;border:1px solid var(--line);background:var(--bg-3);color:var(--txt-1);display:grid;place-items:center;flex-shrink:0;transition:.12s}
.comp-btn:hover{color:#fff;border-color:#3a3f5c}
.comp-btn.rec{background:var(--err);color:#fff;border-color:var(--err);animation:pulse 1.2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,93,108,.5)}50%{box-shadow:0 0 0 7px rgba(255,93,108,0)}}
.send-btn{background:var(--accent-grad);border:none;color:#fff;box-shadow:0 4px 14px rgba(124,92,255,.35)}
.send-btn:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
.composer-hint{max-width:860px;margin:7px auto 0;font-size:10.5px;color:var(--txt-3);text-align:center}

/* ---------- Builder panels (image/video/music/etc) ---------- */
.builder{flex:1;display:flex;overflow:hidden}
.builder-form{width:380px;flex-shrink:0;border-right:1px solid var(--line);overflow-y:auto;padding:20px;background:var(--bg-1)}
.builder-out{flex:1;overflow-y:auto;padding:24px;display:flex;flex-direction:column;gap:18px}
.fgroup{margin-bottom:16px}
.fgroup > label{display:block;font-size:11.5px;text-transform:uppercase;letter-spacing:.7px;color:var(--txt-2);font-weight:700;margin-bottom:7px}
.inp,.ta{width:100%;background:var(--bg-2);border:1px solid var(--line);color:var(--txt-0);border-radius:9px;padding:10px 12px;font-size:13px;outline:none}
.inp:focus,.ta:focus{border-color:var(--accent)}
.ta{resize:vertical;min-height:76px;line-height:1.5}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{background:var(--bg-2);border:1px solid var(--line);color:var(--txt-1);border-radius:20px;padding:6px 12px;font-size:12px;transition:.12s;user-select:none}
.chip:hover{border-color:#3a3f5c;color:#fff}
.chip.on{background:rgba(124,92,255,.16);border-color:var(--accent);color:#fff}
.range-row{display:flex;align-items:center;gap:10px}
.range-row input[type=range]{flex:1;accent-color:var(--accent)}
.range-val{font-family:var(--mono);font-size:12px;color:var(--txt-1);min-width:52px;text-align:right}
.big-btn{width:100%;padding:13px;border:none;border-radius:11px;background:var(--accent-grad);color:#fff;font-weight:700;font-size:14px;box-shadow:0 6px 20px rgba(124,92,255,.35);transition:.12s;display:flex;align-items:center;justify-content:center;gap:8px}
.big-btn:hover{filter:brightness(1.08)}
.big-btn:disabled{opacity:.5;cursor:not-allowed;filter:none}
.ghost-btn{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:var(--bg-2);color:var(--txt-1);font-weight:600;font-size:13px;margin-top:8px}
.ghost-btn:hover{color:#fff;border-color:#3a3f5c}

.out-card{background:var(--bg-1);border:1px solid var(--line);border-radius:var(--radius);padding:16px;animation:fade .25s}
.out-card h4{margin:0 0 10px;font-size:13px;color:var(--txt-1);display:flex;align-items:center;justify-content:space-between}
.out-card h4 .tag{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--txt-3);background:var(--bg-3);padding:3px 8px;border-radius:6px}
.prompt-box{background:var(--bg-0);border:1px solid var(--line);border-radius:9px;padding:12px 14px;font-family:var(--mono);font-size:12.5px;color:var(--txt-0);white-space:pre-wrap;line-height:1.55;overflow-wrap:break-word}
.mini-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.mini-btn{background:var(--bg-3);border:1px solid var(--line);color:var(--txt-1);border-radius:8px;padding:7px 12px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
.mini-btn:hover{color:#fff;border-color:#3a3f5c}

.media-view{width:100%;border-radius:11px;border:1px solid var(--line);background:var(--bg-0);display:block}
img.media-view{cursor:zoom-in;object-fit:contain;max-height:70vh}
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.gallery img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;border:1px solid var(--line);cursor:zoom-in}

.loader{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---------- Markdown ---------- */
.md{line-height:1.6;font-size:14px}
.md h1,.md h2,.md h3{margin:16px 0 8px;line-height:1.3}
.md h1{font-size:19px}.md h2{font-size:17px}.md h3{font-size:15px}
.md p{margin:8px 0}
.md ul,.md ol{margin:8px 0;padding-left:22px}
.md li{margin:3px 0}
.md a{color:var(--accent-2)}
.md strong{color:#fff;font-weight:700}
.md blockquote{border-left:3px solid var(--accent);margin:10px 0;padding:4px 14px;color:var(--txt-1);background:var(--bg-3);border-radius:0 8px 8px 0}
.md table{border-collapse:collapse;margin:10px 0;width:100%;font-size:13px}
.md th,.md td{border:1px solid var(--line);padding:7px 10px;text-align:left}
.md th{background:var(--bg-3)}
.md code.inline{background:var(--bg-0);border:1px solid var(--line);border-radius:5px;padding:1px 6px;font-family:var(--mono);font-size:12.5px;color:#ffd79a}
.code-block{position:relative;margin:12px 0;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#0d0f16}
.code-head{display:flex;align-items:center;justify-content:space-between;padding:7px 12px;background:var(--bg-2);border-bottom:1px solid var(--line);font-size:11px;color:var(--txt-2)}
.code-head .lang{text-transform:uppercase;letter-spacing:.7px;font-weight:700}
.copy-code{background:var(--bg-3);border:1px solid var(--line);color:var(--txt-1);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;display:inline-flex;gap:5px;align-items:center}
.copy-code:hover{color:#fff}
.code-block pre{margin:0;padding:14px;overflow-x:auto;font-family:var(--mono);font-size:12.5px;line-height:1.55}
.code-block code{font-family:var(--mono)}
.tok-kw{color:#c792ea}.tok-str{color:#c3e88d}.tok-num{color:#f78c6c}.tok-com{color:#5c617a;font-style:italic}.tok-fn{color:#82aaff}.tok-punc{color:#89ddff}

/* ---------- Modal ---------- */
.overlay{position:fixed;inset:0;background:rgba(5,6,10,.72);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:100;padding:20px}
.overlay.open{display:flex}
.modal{background:var(--bg-1);border:1px solid var(--line);border-radius:18px;width:100%;max-width:640px;max-height:88vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--shadow)}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--line)}
.modal-head h3{margin:0;font-size:16px}
.modal-head h3 small{display:block;font-weight:500;color:var(--txt-2);font-size:12px;margin-top:2px}
.close-x{background:var(--bg-2);border:1px solid var(--line);width:32px;height:32px;border-radius:8px;color:var(--txt-1);font-size:18px}
.close-x:hover{color:#fff}
.modal-body{padding:18px 22px;overflow-y:auto}
.modal-foot{padding:14px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px}

.provider{border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden;background:var(--bg-2)}
.provider-head{display:flex;align-items:center;gap:11px;padding:13px 15px}
.provider-head .pic{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;font-weight:800;font-size:13px;color:#fff;flex-shrink:0}
.provider-head .pname{font-weight:700;font-size:13.5px}
.provider-head .pdesc{font-size:11.5px;color:var(--txt-2)}
.provider-head .pstat{margin-left:auto;font-size:10.5px;padding:3px 9px;border-radius:20px;border:1px solid var(--line);color:var(--txt-3)}
.provider-head .pstat.set{color:var(--ok);border-color:rgba(46,194,138,.4);background:rgba(46,194,138,.08)}
.provider-fields{padding:0 15px 14px;display:flex;flex-direction:column;gap:9px}
.field-label{font-size:11px;color:var(--txt-2);margin-bottom:4px;display:block}
.key-input{display:flex;gap:7px}
.key-input input{flex:1;background:var(--bg-0);border:1px solid var(--line);color:var(--txt-0);border-radius:8px;padding:9px 11px;font-size:12.5px;font-family:var(--mono);outline:none}
.key-input input:focus{border-color:var(--accent)}
.key-input .eye{background:var(--bg-3);border:1px solid var(--line);color:var(--txt-1);border-radius:8px;width:38px}
.note{font-size:11px;color:var(--txt-3);line-height:1.5;margin:14px 0 2px;padding:12px;border:1px dashed var(--line);border-radius:10px}
.note b{color:var(--warn)}

.btn-primary{background:var(--accent-grad);border:none;color:#fff;padding:10px 18px;border-radius:10px;font-weight:700;font-size:13px;box-shadow:0 4px 14px rgba(124,92,255,.3)}
.btn-ghost{background:var(--bg-2);border:1px solid var(--line);color:var(--txt-1);padding:10px 18px;border-radius:10px;font-weight:600;font-size:13px}
.btn-ghost:hover{color:#fff}

/* ---------- Lightbox ---------- */
#lightbox{position:fixed;inset:0;background:rgba(0,0,0,.9);display:none;align-items:center;justify-content:center;z-index:200;cursor:zoom-out}
#lightbox.open{display:flex}
#lightbox img{max-width:92vw;max-height:92vh;border-radius:8px}

/* ---------- Toast ---------- */
#toasts{position:fixed;bottom:22px;right:22px;z-index:300;display:flex;flex-direction:column;gap:10px}
.toast{background:var(--bg-elev);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;padding:12px 16px;font-size:13px;color:var(--txt-0);box-shadow:var(--shadow);animation:slidein .2s;max-width:340px}
.toast.ok{border-left-color:var(--ok)} .toast.err{border-left-color:var(--err)} .toast.warn{border-left-color:var(--warn)}
@keyframes slidein{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

/* ---------- History drawer ---------- */
.hist-list{display:flex;flex-direction:column;gap:8px}
.hist-item{background:var(--bg-2);border:1px solid var(--line);border-radius:10px;padding:11px 13px;cursor:pointer}
.hist-item:hover{border-color:#3a3f5c}
.hist-item .ht{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hist-item .hm{font-size:11px;color:var(--txt-2);margin-top:3px;display:flex;justify-content:space-between}
.empty-mini{color:var(--txt-3);font-size:12.5px;text-align:center;padding:30px 10px}

.filters-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
canvas{max-width:100%}
.hidden{display:none!important}
@media(max-width:760px){
  #sidebar{position:absolute;z-index:50;height:100%;box-shadow:var(--shadow)}
  #sidebar.collapsed{width:0;border:none}
  .builder{flex-direction:column}
  .builder-form{width:100%;border-right:none;border-bottom:1px solid var(--line);max-height:46%}
  .model-select label{display:none}
  .sel{max-width:150px}
}
</style>
</head>
<body>
<div id="app">
  <!-- ============ SIDEBAR ============ -->
  <aside id="sidebar">
    <div class="brand">
      <div class="logo">AI</div>
      <div class="title">AI Studio<small>Multimedia</small></div>
    </div>
    <nav id="nav"></nav>
    <div class="side-footer">
      <button class="side-btn" id="btnHistory"><span>Historial</span></button>
      <button class="side-btn" id="btnExport"><span>Exportar JSON</span></button>
      <button class="side-btn" id="btnSettings"><span>Ajustes · API Keys</span></button>
    </div>
  </aside>

  <!-- ============ MAIN ============ -->
  <section id="main">
    <header id="topbar">
      <button class="hamb" id="btnHamb" title="Menú"></button>
      <div id="modeTitle">—</div>
      <div class="top-spacer"></div>
      <div class="model-select">
        <label>Modelo</label>
