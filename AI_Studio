function scrollChat(){const s=document.getElementById('chatScroll');if(s)s.scrollTop=s.scrollHeight;}

function wireComposer(m){
  const input=document.getElementById('composerInput');
  const send=document.getElementById('btnSend');
  const composer=document.getElementById('composer');
  autoGrow(input);
  input.addEventListener('input',()=>autoGrow(input));
  input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();doSend(m);}});
  send.onclick=()=>doSend(m);
  document.getElementById('btnAttach').onclick=()=>pickFiles(files=>addAttachments(files));
  document.getElementById('btnMic').onclick=()=>toggleMic(m);
  // Drag & drop
  ['dragenter','dragover'].forEach(ev=>composer.addEventListener(ev,e=>{e.preventDefault();composer.classList.add('drag');}));
  ['dragleave','drop'].forEach(ev=>composer.addEventListener(ev,e=>{e.preventDefault();if(ev==='dragleave'&&composer.contains(e.relatedTarget))return;composer.classList.remove('drag');}));
  composer.addEventListener('drop',e=>{e.preventDefault();if(e.dataTransfer.files.length)addAttachments([...e.dataTransfer.files]);});
  // Paste images
  input.addEventListener('paste',e=>{const imgs=[...e.clipboardData.items].filter(i=>i.type.startsWith('image/')).map(i=>i.getAsFile());if(imgs.length)addAttachments(imgs);});
}
function autoGrow(t){t.style.height='auto';t.style.height=Math.min(t.scrollHeight,220)+'px';}
function pickFiles(cb,accept='*/*',multiple=true){
  const inp=document.createElement('input');inp.type='file';inp.accept=accept;inp.multiple=multiple;
  inp.onchange=()=>cb([...inp.files]);inp.click();
}
function addAttachments(files){
  files.forEach(f=>{
    const reader=new FileReader();
    reader.onload=()=>{
      const kind=f.type.startsWith('image/')?'image':f.type.startsWith('audio/')?'audio':f.type.startsWith('video/')?'video':'file';
      composerAttachments.push({kind,dataURL:reader.result,name:f.name,type:f.type});
      renderCompAtt();
    };
    reader.readAsDataURL(f);
  });
}
function renderCompAtt(){
  const box=document.getElementById('compAtt'); if(!box)return;
  box.innerHTML=composerAttachments.map((a,i)=>{
    const vis=a.kind==='image'?`<img src="${a.dataURL}">`:`<span>${a.kind==='audio'?'🎵':a.kind==='video'?'🎞️':'📄'} ${escapeHtml(a.name)}</span>`;
    return `<div class="ca-item">${vis}<span class="x" data-rm="${i}">×</span></div>`;
  }).join('');
  box.querySelectorAll('[data-rm]').forEach(x=>x.onclick=()=>{composerAttachments.splice(+x.dataset.rm,1);renderCompAtt();});
}

async function doSend(m){
  const input=document.getElementById('composerInput');
  const text=input.value.trim();
  const images=composerAttachments.filter(a=>a.kind==='image').map(a=>a.dataURL);
  const otherAtt=composerAttachments.filter(a=>a.kind!=='image');
  if(!text&&!images.length){return;}
  const modelValue=currentModel();
  const prov=modelValue.split(':')[0];
  if(!keyOf(prov)){toast('Configura la clave de '+PROVIDERS[prov].name+' en Ajustes','warn');openSettings();return;}

  let fullText=text;
  if(otherAtt.length) fullText+='\n\n[Archivos adjuntos no-imagen: '+otherAtt.map(a=>a.name).join(', ')+' — descríbelos o pégalos como texto para que el modelo los procese]';

  const session=getSession(m.id);
  const userMsg={role:'user',text:fullText,images};
  session.push(userMsg);
  appendMsg('user',text||'(imagen)',images);
  input.value='';autoGrow(input);composerAttachments=[];renderCompAtt();

  const aiEl=appendMsg('ai','',null);
  const mdEl=aiEl.querySelector('.md');
  mdEl.innerHTML='<span class="loader"></span>';
  let acc='';
  try{
    await streamChat({modelValue,system:m.system,messages:session,onDelta:(d)=>{acc+=d;mdEl.innerHTML=renderMarkdown(acc);scrollChat();}});
    if(!acc){mdEl.innerHTML='<em style="color:var(--txt-3)">(respuesta vacía)</em>';}
    session.push({role:'assistant',text:acc,images:[]});
    saveHistory(m.id,session);
  }catch(err){
    mdEl.innerHTML=`<div style="color:var(--err)">⚠️ ${escapeHtml(err.message)}</div>`;
    session.pop(); // quitar el user fallido para poder reintentar limpio
  }
}

/* ---------- Grabación de voz (MediaRecorder) ---------- */
let mediaRec=null, recChunks=[], recStream=null;
async function toggleMic(m){
  const btn=document.getElementById('btnMic');
  if(mediaRec&&mediaRec.state==='recording'){
    mediaRec.stop(); return;
  }
  try{
    recStream=await navigator.mediaDevices.getUserMedia({audio:true});
    recChunks=[]; mediaRec=new MediaRecorder(recStream);
    mediaRec.ondataavailable=e=>{if(e.data.size)recChunks.push(e.data);};
    mediaRec.onstop=async()=>{
      btn.classList.remove('rec'); recStream.getTracks().forEach(t=>t.stop());
      const blob=new Blob(recChunks,{type:'audio/webm'});
      // Si hay OpenAI key, transcribir con Whisper; si no, adjuntar como audio
      if(keyOf('openai')){
        toast('Transcribiendo con Whisper…');
        try{const txt=await whisperTranscribe(blob);const inp=document.getElementById('composerInput');inp.value=(inp.value?inp.value+' ':'')+txt;autoGrow(inp);toast('Transcripción lista','ok');}
        catch(e){toast('Whisper: '+e.message,'err');attachAudioBlob(blob);}
      } else { attachAudioBlob(blob); toast('Audio adjuntado (añade clave OpenAI para transcribir)','warn'); }
    };
    mediaRec.start(); btn.classList.add('rec');
    toast('Grabando… pulsa de nuevo para parar');
  }catch(e){ toast('No se pudo acceder al micrófono: '+e.message,'err'); }
}
function attachAudioBlob(blob){
  const r=new FileReader();r.onload=()=>{composerAttachments.push({kind:'audio',dataURL:r.result,name:'grabacion.webm',type:'audio/webm',blob});renderCompAtt();};r.readAsDataURL(blob);
}
async function whisperTranscribe(blob){
  const key=keyOf('openai'); if(!key)throw new Error('Falta clave OpenAI');
  const fd=new FormData();fd.append('file',blob,'audio.webm');fd.append('model','whisper-1');
  const res=await fetch((keyOf('openai','base')||PROVIDERS.openai.base)+'/v1/audio/transcriptions',{method:'POST',headers:{'authorization':'Bearer '+key},body:fd});
  if(!res.ok)throw new Error('Whisper '+res.status+': '+(await res.text()).slice(0,200));
  return (await res.json()).text;
}

