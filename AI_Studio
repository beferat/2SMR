/* ============================================================
   MARKDOWN + RESALTADO DE SINTAXIS (self-contained)
   ============================================================ */
function escapeHtml(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
const KW=/\b(const|let|var|function|return|if|else|for|while|do|switch|case|break|continue|class|extends|new|this|super|import|export|from|default|async|await|try|catch|finally|throw|typeof|instanceof|in|of|void|yield|def|print|elif|lambda|None|True|False|self|public|private|protected|static|int|float|double|string|bool|var|func|package|struct|enum|interface|namespace|using|include|def|end|then|nil|puts|require|module|fn|let|mut|pub|use|impl|match|where|type)\b/g;
function highlight(code){
  let h=escapeHtml(code);
  const store=[]; const PH=i=>`\u0000${i}\u0000`;
  // comments
  h=h.replace(/(\/\/[^\n]*|#[^\n]*|\/\*[\s\S]*?\*\/)/g,m=>{store.push(`<span class="tok-com">${m}</span>`);return PH(store.length-1);});
  // strings
  h=h.replace(/(&#39;(?:[^&]|&(?!#39;))*?&#39;|&quot;(?:[^&]|&(?!quot;))*?&quot;|`(?:[^`])*?`)/g,m=>{store.push(`<span class="tok-str">${m}</span>`);return PH(store.length-1);});
  // numbers
  h=h.replace(/\b(0x[\da-fA-F]+|\d+\.?\d*(?:e[+-]?\d+)?)\b/g,'<span class="tok-num">$1</span>');
  // functions
  h=h.replace(/\b([a-zA-Z_]\w*)(\s*\()/g,'<span class="tok-fn">$1</span>$2');
  // keywords
  h=h.replace(KW,'<span class="tok-kw">$&</span>');
  // restore
  h=h.replace(/\u0000(\d+)\u0000/g,(_,i)=>store[i]);
  return h;
}
function renderMarkdown(src){
  const blocks=[]; let text=src.replace(/```(\w*)\n?([\s\S]*?)```/g,(_,lang,code)=>{
    const l=(lang||'txt').toLowerCase();
    const html=`<div class="code-block"><div class="code-head"><span class="lang">${l}</span><button class="copy-code" data-copy>${copySvg()}Copiar</button></div><pre><code>${highlight(code.replace(/\n$/,''))}</code></pre></div>`;
    blocks.push(html); return `\u0001${blocks.length-1}\u0001`;
  });
  text=escapeHtml(text);
  // tables
  text=text.replace(/(?:^\|.*\|\s*\n)(?:^\|[\s:|-]+\|\s*\n)((?:^\|.*\|\s*\n?)*)/gm,m=>{
    const rows=m.trim().split('\n').map(r=>r.trim());
    const head=rows[0].split('|').slice(1,-1).map(c=>`<th>${c.trim()}</th>`).join('');
    const body=rows.slice(2).map(r=>`<tr>${r.split('|').slice(1,-1).map(c=>`<td>${c.trim()}</td>`).join('')}</tr>`).join('');
    return `<table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
  });
  text=text
    .replace(/^###### (.*)$/gm,'<h3>$1</h3>').replace(/^##### (.*)$/gm,'<h3>$1</h3>')
    .replace(/^#### (.*)$/gm,'<h3>$1</h3>').replace(/^### (.*)$/gm,'<h3>$1</h3>')
    .replace(/^## (.*)$/gm,'<h2>$1</h2>').replace(/^# (.*)$/gm,'<h1>$1</h1>')
    .replace(/^&gt; (.*)$/gm,'<blockquote>$1</blockquote>')
    .replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>')
    .replace(/(^|[^*])\*([^*\n]+)\*/g,'$1<em>$2</em>')
    .replace(/`([^`\n]+)`/g,'<code class="inline">$1</code>')
    .replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>');
  // lists
  text=text.replace(/(?:^(?:[-*+]|\d+\.) .*(?:\n|$))+/gm,m=>{
    const ordered=/^\s*\d+\./.test(m);
    const items=m.trim().split('\n').map(l=>`<li>${l.replace(/^\s*(?:[-*+]|\d+\.)\s/,'')}</li>`).join('');
    return `<${ordered?'ol':'ul'}>${items}</${ordered?'ol':'ul'}>`;
  });
  // paragraphs
  text=text.split(/\n{2,}/).map(p=>{
    if(/^\s*<(h\d|ul|ol|table|blockquote|div|pre)/.test(p.trim())||p.includes('\u0001')) return p;
    return p.trim()?`<p>${p.replace(/\n/g,'<br>')}</p>`:'';
  }).join('\n');
  text=text.replace(/\u0001(\d+)\u0001/g,(_,i)=>blocks[i]);
  return text;
}
function copySvg(){return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';}
// Delegación global: copiar bloques de código
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-copy]');
  if(b){ const code=b.closest('.code-block').querySelector('code').innerText; navigator.clipboard.writeText(code).then(()=>{b.innerHTML=copySvg()+'Copiado';setTimeout(()=>b.innerHTML=copySvg()+'Copiar',1500);}); }
});

