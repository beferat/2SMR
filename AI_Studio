async function genOpenAIImage(model,prompt,size,n){
  const key=keyOf('openai');if(!key)throw new Error('Falta clave OpenAI');
  // Tamaños válidos OpenAI
  const map={'1024x1024':'1024x1024','1344x768':'1792x1024','768x1344':'1024x1792','1152x896':'1024x1024','1216x832':'1792x1024','1536x640':'1792x1024'};
  const body={model,prompt,n:model==='dall-e-3'?1:n,size:map[size]||'1024x1024'};
  if(model==='gpt-image-1')body.n=n;
  const res=await fetch((keyOf('openai','base')||PROVIDERS.openai.base)+'/v1/images/generations',{method:'POST',headers:{'content-type':'application/json','authorization':'Bearer '+key},body:JSON.stringify(body)});
  if(!res.ok)throw new Error('OpenAI '+res.status+': '+(await res.text()).slice(0,250));
  const data=(await res.json()).data;
  return data.map(d=>d.b64_json?('data:image/png;base64,'+d.b64_json):d.url);
}
async function genStabilityImage(sub,prompt,neg,size,seed,cfg){
  const key=keyOf('stability');if(!key)throw new Error('Falta clave Stability');
  const ep={core:'/v2beta/stable-image/generate/core',ultra:'/v2beta/stable-image/generate/ultra',sd3:'/v2beta/stable-image/generate/sd3'}[sub];
  const [w,h]=size.split('x').map(Number);
  const ar=closestStabilityRatio(w,h);
  const fd=new FormData();fd.append('prompt',prompt);if(neg)fd.append('negative_prompt',neg);fd.append('aspect_ratio',ar);if(seed)fd.append('seed',seed);fd.append('output_format','png');
  const res=await fetch((keyOf('stability','base')||PROVIDERS.stability.base)+ep,{method:'POST',headers:{'authorization':'Bearer '+key,'accept':'image/*'},body:fd});
  if(!res.ok)throw new Error('Stability '+res.status+': '+(await res.text()).slice(0,250));
  const blob=await res.blob();return [URL.createObjectURL(blob)];
}
function closestStabilityRatio(w,h){const r=w/h;const opts={'1:1':1,'16:9':16/9,'9:16':9/16,'4:3':4/3,'3:2':3/2,'21:9':21/9,'2:3':2/3,'3:4':3/4};let best='1:1',bd=1e9;for(const k in opts){const d=Math.abs(opts[k]-r);if(d<bd){bd=d;best=k;}}return best;}

