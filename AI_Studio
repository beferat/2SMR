  const base=keyOf('anthropic','base')||PROVIDERS.anthropic.base;
  const msgs=messages.map(m=>{
    const content=[]; if(m.text) content.push({type:'text',text:m.text});
    (m.images||[]).forEach(d=>{const[meta,b64]=d.split(',');const mt=(meta.match(/data:(.*?);/)||[])[1]||'image/png';content.push({type:'image',source:{type:'base64',media_type:mt,data:b64}});});
    return {role:m.role,content};
  });
  const res=await fetch(base+'/v1/messages',{method:'POST',headers:{'content-type':'application/json','x-api-key':key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
    body:JSON.stringify({model,max_tokens:4096,system,stream:true,messages:msgs})});
  if(!res.ok){throw new Error('Anthropic '+res.status+': '+(await res.text()).slice(0,300));}
  await readSSE(res,(json)=>{
    try{const o=JSON.parse(json); if(o.type==='content_block_delta'&&o.delta&&o.delta.text) onDelta(o.delta.text);}catch(e){}
  });
}
async function streamOpenAI(model,system,messages,onDelta){
  const key=keyOf('openai'); if(!key) throw new Error('Configura la API Key de OpenAI en Ajustes.');
  const base=keyOf('openai','base')||PROVIDERS.openai.base;
  const msgs=[{role:'system',content:system}];
  messages.forEach(m=>{
    if(m.images&&m.images.length){const content=[{type:'text',text:m.text||''}];m.images.forEach(d=>content.push({type:'image_url',image_url:{url:d}}));msgs.push({role:m.role,content});}
    else msgs.push({role:m.role,content:m.text||''});
  });
  const res=await fetch(base+'/v1/chat/completions',{method:'POST',headers:{'content-type':'application/json','authorization':'Bearer '+key},
    body:JSON.stringify({model,messages:msgs,stream:true,max_tokens:4096})});
  if(!res.ok){throw new Error('OpenAI '+res.status+': '+(await res.text()).slice(0,300));}
  await readSSE(res,(json)=>{
    if(json==='[DONE]')return;
    try{const o=JSON.parse(json);const d=o.choices&&o.choices[0]&&o.choices[0].delta;if(d&&d.content)onDelta(d.content);}catch(e){}
  });
}
async function streamGemini(model,system,messages,onDelta){
  const key=keyOf('gemini'); if(!key) throw new Error('Configura la API Key de Google Gemini en Ajustes.');
  const base=keyOf('gemini','base')||PROVIDERS.gemini.base;
  const contents=messages.map(m=>{
    const parts=[]; if(m.text) parts.push({text:m.text});
    (m.images||[]).forEach(d=>{const[meta,b64]=d.split(',');const mt=(meta.match(/data:(.*?);/)||[])[1]||'image/png';parts.push({inline_data:{mime_type:mt,data:b64}});});
    if(!parts.length) parts.push({text:''});
    return {role:m.role==='assistant'?'model':'user',parts};
  });
  const body={contents,generationConfig:{maxOutputTokens:4096}};
  if(system) body.systemInstruction={parts:[{text:system}]};
  const res=await fetch(base+'/v1beta/models/'+model+':streamGenerateContent?alt=sse',{method:'POST',headers:{'content-type':'application/json','x-goog-api-key':key},body:JSON.stringify(body)});
  if(!res.ok){throw new Error('Gemini '+res.status+': '+(await res.text()).slice(0,300));}
  await readSSE(res,(json)=>{
    try{const o=JSON.parse(json);const parts=o.candidates&&o.candidates[0]&&o.candidates[0].content&&o.candidates[0].content.parts;if(parts)parts.forEach(p=>{if(p.text)onDelta(p.text);});}catch(e){}
  });
}
async function readSSE(res,onEvent){
  const reader=res.body.getReader(); const dec=new TextDecoder(); let buf='';
  while(true){
    const {done,value}=await reader.read(); if(done)break;
    buf+=dec.decode(value,{stream:true});
    let idx;
    while((idx=buf.indexOf('\n'))>=0){
      const line=buf.slice(0,idx).trim(); buf=buf.slice(idx+1);
      if(line.startsWith('data:')) onEvent(line.slice(5).trim());
    }
  }
}

