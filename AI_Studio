<!-- ===================== LÓGICA ===================== -->
<script type="module">
import * as webllm from "https://esm.run/@mlc-ai/web-llm";

/* ---------- Estado global ---------- */
const state = {
  engine:null, loading:false, generating:false, modelId:null,
  messages:[], sessionId:null, lastImage:null,
  transformers:null, visionPipe:null,
  audioCtx:null, musicStop:false,
