async function synthVoice(){
  const text=document.getElementById('ttsText').value.trim();
  if(!text){toast('Escribe el texto','warn');return;}
  const mv=currentModel();
  const out=document.getElementById('sndOut');
  const btn=document.getElementById('ttsGen');btn.disabled=true;btn.innerHTML='<span class="loader"></span>Sintetizando…';
  const card=makeCard('Locución','TTS','<span class="loader"></span>');prependOut(out,card);
  try{
    let blob;
    if(mv==='elevenlabs'){ blob=await elevenTTS(text); }
    else if(mv.startsWith('openai:')){ blob=await openaiTTS(mv.split(':')[1],text,document.getElementById('ttsVoice').value); }
    else throw new Error('Selecciona un modelo TTS arriba');
    const url=URL.createObjectURL(blob);
    card.querySelector('.card-content').innerHTML=`<audio class="media-view" controls src="${url}" style="height:48px"></audio><div class="prompt-box" style="margin-top:10px">${escapeHtml(text)}</div>`;
    const acts=document.createElement('div');acts.className='mini-actions';const b=document.createElement('button');b.className='mini-btn';b.innerHTML='Descargar audio';b.onclick=()=>downloadURL(url,'locucion_'+Date.now()+'.mp3');acts.appendChild(b);card.querySelector('.card-content').appendChild(acts);
  }catch(e){card.querySelector('.card-content').innerHTML='<div style="color:var(--err)">⚠️ '+escapeHtml(e.message)+'</div>';}
  finally{btn.disabled=false;btn.innerHTML=ICONS.wave+'Sintetizar voz';}
}
async function elevenTTS(text){
  const key=keyOf('elevenlabs');if(!key)throw new Error('Falta clave ElevenLabs');
  const voice=keyOf('elevenlabs','voice')||'21m00Tcm4TlvDq8ikWAM';
  const stab=+document.getElementById('ttsStab').value, sim=+document.getElementById('ttsSim').value;
  const res=await fetch((keyOf('elevenlabs','base')||PROVIDERS.elevenlabs.base)+'/v1/text-to-speech/'+voice,{method:'POST',headers:{'xi-api-key':key,'content-type':'application/json','accept':'audio/mpeg'},body:JSON.stringify({text,model_id:'eleven_multilingual_v2',voice_settings:{stability:stab,similarity_boost:sim}})});
  if(!res.ok)throw new Error('ElevenLabs '+res.status+': '+(await res.text()).slice(0,200));
  return res.blob();
}
async function openaiTTS(model,text,voice){
  const key=keyOf('openai');if(!key)throw new Error('Falta clave OpenAI');
  const res=await fetch((keyOf('openai','base')||PROVIDERS.openai.base)+'/v1/audio/speech',{method:'POST',headers:{'authorization':'Bearer '+key,'content-type':'application/json'},body:JSON.stringify({model,input:text,voice:voice||'alloy'})});
  if(!res.ok)throw new Error('OpenAI TTS '+res.status+': '+(await res.text()).slice(0,200));
  return res.blob();
}
async function genSfxPrompt(m){
  const text=document.getElementById('sfxText').value.trim();
  if(!text){toast('Describe el efecto','warn');return;}
  const mv=currentModel();
  // Para SFX usamos un modelo de chat si está disponible; si el modelo activo es TTS, caemos a chat
  const chatProv=mv.split(':')[0];
  const chatModel=(chatProv==='openai'||chatProv==='anthropic'||chatProv==='gemini')?mv:(keyOf('anthropic')?'anthropic:'+MODELS.anthropic[0].id:keyOf('openai')?'openai:'+MODELS.openai[0].id:keyOf('gemini')?'gemini:'+MODELS.gemini[0].id:null);
  if(!chatModel){toast('Configura una clave de chat (Anthropic/OpenAI)','warn');openSettings();return;}
  const out=document.getElementById('sndOut');const card=makeCard('Prompt SFX','SOUND DESIGN','<span class="loader"></span>');prependOut(out,card);
  const sys='Eres diseñador de sonido profesional. Para un efecto descrito, devuelves: un prompt técnico en inglés para generadores de SFX (capas, materiales, acústica, duración, reverb), y sugerencias de síntesis/foley. Markdown breve.';
  let acc='';const c=card.querySelector('.card-content');
  try{await streamChat({modelValue:chatModel,system:sys,messages:[{role:'user',text}],onDelta:d=>{acc+=d;c.innerHTML='<div class="md">'+renderMarkdown(acc)+'</div>';}});}
  catch(e){c.innerHTML='<div style="color:var(--err)">⚠️ '+escapeHtml(e.message)+'</div>';}
}

