};
log('NEXUS inicializado. Esperando detección de hardware…','ok');

/* ---------- Sidebar móvil ---------- */
$('#menuBtn').onclick=()=>{$('#side').classList.add('open');$('#scrim').classList.add('on');};
$('#scrim').onclick=()=>{$('#side').classList.remove('open');$('#scrim').classList.remove('on');};

/* ===================== MODOS DE OPERACIÓN ===================== */
const MODES = {
  general:{icon:'✦',name:'General',desc:'Asistente unificado',temp:0.6,
    sys:'Eres NEXUS, una IA local y autónoma que se ejecuta en el navegador del usuario mediante WebGPU. Respondes en español, con precisión técnica, formato Markdown y bloques de código cuando aporten valor.'},
  cyber:{icon:'🛡',name:'Ciberseguridad',desc:'Auditoría · hardening defensivo',temp:0.3,
    sys:'Eres el NÚCLEO DE CIBERSEGURIDAD DEFENSIVA de NEXUS. Audita código en busca de vectores comunes (inyección, XSS, deserialización insegura, secretos expuestos, validación ausente), explica el riesgo, su severidad y la mitigación concreta con código corregido. Enfoque estrictamente DEFENSIVO y de hardening: nunca generes exploits armables ni instrucciones ofensivas. Responde en español con listas claras y bloques de código.'},
  dev:{icon:'🎮',name:'Dev & Games',desc:'JS · GLSL · Canvas',temp:0.5,
    sys:'Eres el NÚCLEO DE DESARROLLO Y VIDEOJUEGOS de NEXUS. Generas lógica de juego y software en JavaScript, GLSL y HTML5 Canvas/WebGL, optimizas algoritmos (complejidad, memoria, rendimiento) y propones arquitecturas limpias. Entregas código completo, comentado y ejecutable. Responde en español con bloques de código.'},
  vision:{icon:'👁',name:'Visión',desc:'Imagen · Canvas · ViT',temp:0.5,
    sys:'Eres el NÚCLEO MULTIMEDIA Y VISIÓN de NEXUS. Razonas sobre procesamiento de imagen en navegador (Canvas, filtros, convoluciones, embeddings, clasificación con modelos de visión locales). Si el usuario ha analizado una imagen, interpreta los resultados. Responde en español, técnico y práctico.'},
  audio:{icon:'🎙',name:'Audio & Voz',desc:'STT · TTS · comandos',temp:0.5,
    sys:'Eres el NÚCLEO DE AUDIO Y VOZ de NEXUS. Procesas comandos dictados por voz, redactas respuestas pensadas para ser leídas en voz alta (frases claras, sin tablas largas) y ayudas con transcripción y síntesis. Responde en español, conciso y natural.'},
  music:{icon:'🎵',name:'Música',desc:'Secuencias · acordes · ritmo',temp:0.8,
    sys:'Eres el NÚCLEO DE CREACIÓN Y ESTRUCTURACIÓN MUSICAL de NEXUS. Diseñas progresiones de acordes, patrones rítmicos, estructuras de composición y melodías. Cuando se te pida una secuencia tocable, devuélvela SIEMPRE en un bloque ```json con la forma {"bpm":110,"notes":[{"note":"C4","start":0,"dur":0.5}]} usando nombres científicos (C4, D#4…), start y dur en tiempos (beats). Además explica la idea musical. Responde en español.'},
};
let currentMode = 'general';
const modesEl = $('#modes');
for(const [k,m] of Object.entries(MODES)){
  const b = el('button','mode'+(k==='general'?' active':''));
