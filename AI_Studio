/* ---------- Sliders ---------- */
const bind=(id,vid,fmt=v=>v)=>{const i=$('#'+id),o=$('#'+vid);const u=()=>o.textContent=fmt(i.value);i.oninput=u;u();};
bind('temp','tempV',v=>Number(v).toFixed(2));
bind('topp','toppV',v=>Number(v).toFixed(2));
