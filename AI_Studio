        <div class="filters-row">
          <span class="chip" data-f="grayscale(100%)">B/N</span><span class="chip" data-f="sepia(100%)">Sepia</span>
          <span class="chip" data-f="invert(100%)">Invertir</span><span class="chip" data-f="hue-rotate(90deg)">Hue</span>
        </div>
      </div>
      <div id="medConvertOpts" class="hidden"><div class="fgroup"><label>Formato destino</label>
        <select class="inp" id="medFmt"><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option></select></div></div>
      <div id="medFrameOpts" class="hidden"><div class="fgroup"><label>Frames a extraer</label><input class="inp" id="medFrames" type="number" value="6" min="1" max="24"></div></div>

      <button class="big-btn" id="medRun" style="margin-top:6px">${ICONS.edit}Procesar</button>
    </div>
    <div class="builder-out" id="medOut"><div class="empty-state"><div class="big">${ICONS.edit}</div><h2>Mesa de edición</h2><p>Sube una imagen, vídeo o audio y aplica filtros en Canvas, conviértelo, extrae frames o transcríbelo (Whisper).</p></div></div>
  </div></div>`;
  let currentFile=null, currentDataURL=null;
  const tools={filter:'#medFilterOpts',convert:'#medConvertOpts',frames:'#medFrameOpts',transcribe:null};
  function showTool(v){Object.entries(tools).forEach(([k,sel])=>{if(sel)view.querySelector(sel).classList.toggle('hidden',k!==v);});}
  view.querySelectorAll('#medTool .chip').forEach(c=>c.onclick=()=>{view.querySelectorAll('#medTool .chip').forEach(x=>x.classList.remove('on'));c.classList.add('on');showTool(c.dataset.v);});
  // sliders
  [['fBri','fBriV','%'],['fCon','fConV','%'],['fSat','fSatV','%'],['fBlur','fBlurV','px']].forEach(([id,vid,u])=>{const el=view.querySelector('#'+id);el.oninput=()=>{view.querySelector('#'+vid).textContent=el.value+u;livePreview();};});
  let extraFilters=new Set();
  view.querySelectorAll('.filters-row .chip').forEach(c=>c.onclick=()=>{c.classList.toggle('on');c.classList.contains('on')?extraFilters.add(c.dataset.f):extraFilters.delete(c.dataset.f);livePreview();});
