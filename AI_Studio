  }
  view.querySelector('#medRun').onclick=async()=>{
    if(!currentFile){toast('Selecciona un archivo','warn');return;}
    const tool=view.querySelector('#medTool .chip.on').dataset.v;
    const out=view.querySelector('#medOut');
    if(tool==='filter'){livePreview();return;}
    if(tool==='convert'){
      if(!currentFile.type.startsWith('image/')){toast('La conversión es para imágenes','warn');return;}
      const fmt=view.querySelector('#medFmt').value;const img=new Image();img.onload=()=>{const cv=document.createElement('canvas');cv.width=img.width;cv.height=img.height;cv.getContext('2d').drawImage(img,0,0);const url=cv.toDataURL(fmt,.92);const card=makeCard('Convertido',''+fmt.split('/')[1].toUpperCase(),`<img class="media-view" src="${url}">`);prependOut(out,card);const acts=document.createElement('div');acts.className='mini-actions';const b=document.createElement('button');b.className='mini-btn';b.textContent='Descargar';b.onclick=()=>downloadURL(url,'convertida.'+fmt.split('/')[1]);acts.appendChild(b);card.querySelector('.card-content').appendChild(acts);};img.src=currentDataURL;
    }
    if(tool==='frames'){
      if(!currentFile.type.startsWith('video/')){toast('Selecciona un vídeo','warn');return;}
      const n=Math.max(1,Math.min(24,+view.querySelector('#medFrames').value||6));
      const card=makeCard('Frames extraídos','VÍDEO','<span class="loader"></span>');prependOut(out,card);
      try{const frames=await extractFrames(currentDataURL,n);card.querySelector('.card-content').innerHTML=`<div class="gallery">${frames.map((f,i)=>`<img src="${f}" onclick="openLightbox('${f}')">`).join('')}</div>`;const acts=document.createElement('div');acts.className='mini-actions';frames.forEach((f,i)=>{const b=document.createElement('button');b.className='mini-btn';b.textContent='Frame '+(i+1);b.onclick=()=>downloadURL(f,'frame_'+(i+1)+'.png');acts.appendChild(b);});card.querySelector('.card-content').appendChild(acts);}
      catch(e){card.querySelector('.card-content').innerHTML='<div style="color:var(--err)">⚠️ '+escapeHtml(e.message)+'</div>';}
    }
    if(tool==='transcribe'){
      if(!(currentFile.type.startsWith('audio/')||currentFile.type.startsWith('video/'))){toast('Selecciona audio o vídeo','warn');return;}
      if(!keyOf('openai')){toast('La transcripción usa Whisper (clave OpenAI)','warn');openSettings();return;}
      const card=makeCard('Transcripción','WHISPER','<span class="loader"></span>');prependOut(out,card);
      try{const txt=await whisperTranscribe(currentFile);card.querySelector('.card-content').innerHTML=`<div class="prompt-box">${escapeHtml(txt)}</div>`;const acts=document.createElement('div');acts.className='mini-actions';acts.innerHTML=`<button class="mini-btn" onclick="copyText(${JSON.stringify(txt)},this)">Copiar texto</button>`;card.querySelector('.card-content').appendChild(acts);}
      catch(e){card.querySelector('.card-content').innerHTML='<div style="color:var(--err)">⚠️ '+escapeHtml(e.message)+'</div>';}
    }
  };
}
function extractFrames(dataURL,n){
  return new Promise((resolve,reject)=>{
    const v=document.createElement('video');v.src=dataURL;v.muted=true;v.crossOrigin='anonymous';
    v.onloadedmetadata=async()=>{
      const dur=v.duration;if(!isFinite(dur)||dur===0){reject(new Error('No se pudo leer la duración del vídeo'));return;}
      const frames=[];const cv=document.createElement('canvas');
      for(let i=0;i<n;i++){
        const t=dur*(i+0.5)/n;
        await seek(v,t);
        cv.width=v.videoWidth;cv.height=v.videoHeight;cv.getContext('2d').drawImage(v,0,0);
        frames.push(cv.toDataURL('image/png'));
      }
      resolve(frames);
    };
    v.onerror=()=>reject(new Error('Error cargando el vídeo'));
  });
}
function seek(v,t){return new Promise(res=>{const h=()=>{v.removeEventListener('seeked',h);res();};v.addEventListener('seeked',h);v.currentTime=t;});}

/* ============================================================
   UTILIDADES DE UI (cards, copy, download, lightbox)
   ============================================================ */
function makeCard(title,tag,contentHtml,actions){
  const el=document.createElement('div');el.className='out-card';
  el.innerHTML=`<h4>${escapeHtml(title)} <span class="tag">${escapeHtml(tag)}</span></h4><div class="card-content">${contentHtml}</div>`;
  if(actions&&actions.length){const row=document.createElement('div');row.className='mini-actions';actions.forEach(a=>{const b=document.createElement('button');b.className='mini-btn';b.textContent=a.label;b.onclick=()=>a.fn(b);row.appendChild(b);});el.querySelector('.card-content').appendChild(row);}
  return el;
}
function prependOut(container,card){const empty=container.querySelector('.empty-state');if(empty)empty.remove();container.insertBefore(card,container.firstChild);}
function copyText(t,btn){navigator.clipboard.writeText(t).then(()=>{if(btn){const o=btn.textContent;btn.textContent='Copiado ✓';setTimeout(()=>btn.textContent=o,1400);}toast('Copiado','ok',1500);});}
window.copyText=copyText;
function downloadURL(url,name){const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();}
function openLightbox(src){document.getElementById('lightboxImg').src=src;document.getElementById('lightbox').classList.add('open');}
window.openLightbox=openLightbox;
document.getElementById('lightbox').onclick=()=>document.getElementById('lightbox').classList.remove('open');

/* ============================================================
   HISTORIAL Y PROYECTOS
   ============================================================ */
function saveHistory(mode,session){
  const h=Store.get(K_HIST,{});
  h[mode]=h[mode]||[];
  const first=session.find(x=>x.role==='user');
  const title=first?first.text.slice(0,60):'Sesión';
  // reemplazar la sesión actual (una por "hilo" simple): guardamos snapshot
  h[mode].unshift({title,at:Date.now(),turns:session.length,snapshot:session});
  h[mode]=h[mode].slice(0,30);
  Store.set(K_HIST,h);
}
function saveProject(mode,data){
  const p=Store.get(K_PROJ,{});p[mode]=p[mode]||[];p[mode].unshift(data);p[mode]=p[mode].slice(0,50);Store.set(K_PROJ,p);
}
function openHistory(){
  const h=Store.get(K_HIST,{});const list=document.getElementById('histList');
  const all=[];Object.entries(h).forEach(([mode,arr])=>arr.forEach(s=>all.push({mode,...s})));
  all.sort((a,b)=>b.at-a.at);
  if(!all.length){list.innerHTML='<div class="empty-mini">Aún no hay sesiones guardadas.</div>';}
  else list.innerHTML=all.map((s,i)=>`<div class="hist-item" data-mode="${s.mode}" data-i="${i}"><div class="ht">${escapeHtml(s.title||'Sesión')}</div><div class="hm"><span>${MODE_BY_ID[s.mode]?MODE_BY_ID[s.mode].title:s.mode} · ${s.turns||0} turnos</span><span>${new Date(s.at).toLocaleString('es-ES')}</span></div></div>`).join('');
  list.querySelectorAll('.hist-item').forEach(el=>el.onclick=()=>{
    const s=all[+el.dataset.i];const mode=s.mode;
    if(MODE_BY_ID[mode]&&MODE_BY_ID[mode].kind==='chat'&&s.snapshot){sessions[mode]=JSON.parse(JSON.stringify(s.snapshot));switchMode(mode);toast('Sesión restaurada','ok');closeOverlays();}
    else{switchMode(mode);closeOverlays();}
  });
  document.getElementById('historyOverlay').classList.add('open');
}
document.getElementById('btnClearHistory')&&(document.getElementById('btnClearHistory').onclick=()=>{Store.del(K_HIST);openHistory();toast('Historial vaciado','ok');});

/* ---------- Export JSON ---------- */
function exportAll(){
  const data={exported_at:new Date().toISOString(),keys_present:Object.keys(keys()),history:Store.get(K_HIST,{}),projects:Store.get(K_PROJ,{}),ui:Store.get(K_UI,{})};
  // No exportamos las claves por seguridad, solo qué proveedores están configurados
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  downloadURL(URL.createObjectURL(blob),'ai-studio-backup-'+Date.now()+'.json');
  toast('Backup exportado (sin claves por seguridad)','ok');
}

/* ============================================================
   AJUSTES / API KEYS
   ============================================================ */
function renderProviders(){
  const body=document.getElementById('providersBody');const cur=keys();
  body.innerHTML=Object.entries(PROVIDERS).map(([id,p])=>{
    const set=cur[id]&&cur[id].key;
    return `<div class="provider"><div class="provider-head">
      <div class="pic" style="background:${p.color}">${p.name[0]}</div>
      <div><div class="pname">${p.name}</div><div class="pdesc">${p.desc}</div></div>
      <div class="pstat ${set?'set':''}">${set?'Configurado':'Vacío'}</div></div>
      <div class="provider-fields">${p.fields.map(f=>`
        <div><span class="field-label">${f.label}</span>
        <div class="key-input"><input type="${f.id==='key'?'password':'text'}" data-prov="${id}" data-field="${f.id}" placeholder="${f.ph}" value="${cur[id]&&cur[id][f.id]?escapeAttr(cur[id][f.id]):''}">
        ${f.id==='key'?'<button class="eye" data-eye>👁</button>':''}</div></div>`).join('')}
      </div></div>`;
  }).join('')+`<div class="note"><b>Importante:</b> Las claves se guardan únicamente en el LocalStorage de este navegador. Anthropic, OpenAI y Google Gemini permiten llamadas directas desde el navegador; <b>Replicate, Runway/Luma/Pika y Suno</b> normalmente bloquean CORS, por lo que requieren un proxy propio (campo "Proxy"). El prompt builder funciona siempre aunque no haya API.</div>`;
  body.querySelectorAll('[data-eye]').forEach(b=>b.onclick=()=>{const inp=b.previousElementSibling;inp.type=inp.type==='password'?'text':'password';});
}
function escapeAttr(s){return String(s).replace(/"/g,'&quot;');}
function openSettings(){renderProviders();document.getElementById('settingsOverlay').classList.add('open');}
function saveKeys(){
  const cur={};
  document.querySelectorAll('#providersBody input[data-prov]').forEach(inp=>{
    const p=inp.dataset.prov,f=inp.dataset.field,v=inp.value.trim();
    if(v){cur[p]=cur[p]||{};cur[p][f]=v;}
  });
  Store.set(K_KEYS,cur);toast('Claves guardadas','ok');updateConnStatus();closeOverlays();
}
function closeOverlays(){document.querySelectorAll('.overlay').forEach(o=>o.classList.remove('open'));}

/* ============================================================
   WIRING GLOBAL
   ============================================================ */
document.addEventListener('click',e=>{if(e.target.hasAttribute('data-close')||e.target.closest('[data-close]'))closeOverlays();});
document.querySelectorAll('.overlay').forEach(o=>o.addEventListener('mousedown',e=>{if(e.target===o)closeOverlays();}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeOverlays();document.getElementById('lightbox').classList.remove('open');}});
// Footer buttons (re-wire tras innerHTML)
document.getElementById('btnSettings').onclick=openSettings;
document.getElementById('btnHistory').onclick=openHistory;
document.getElementById('btnExport').onclick=exportAll;
document.getElementById('btnSaveKeys').onclick=saveKeys;
document.getElementById('btnClearKeys').onclick=()=>{if(confirm('¿Borrar todas las claves guardadas?')){Store.del(K_KEYS);renderProviders();updateConnStatus();toast('Claves borradas','ok');}};

/* ---------- Arranque ---------- */
switchMode('ai');
if(!hasAnyChatKey()){ setTimeout(()=>{toast('Añade tu API Key en Ajustes para empezar','warn',5000);},600); }
</script>
